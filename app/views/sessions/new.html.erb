<h1 class="text-xl font-bold mb-6"><%= t("session.new.title") %></h1>

<%= form_with url: session_path, method: :post, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :phone_number, t("session.new.phone_number"), class: "block font-semibold mb-1" %>
    <%= form.text_field :phone_number, inputmode: "numeric", autocomplete: "tel",
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
  </div>
  <div>
    <%= form.label :password, t("session.new.password"), class: "block font-semibold mb-1" %>
    <%= form.password_field :password, autocomplete: "current-password",
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
  </div>
  <%= form.submit t("session.new.submit"),
        class: "w-full min-h-12 rounded-lg bg-indigo-600 text-white font-semibold text-base hover:bg-indigo-700" %>
<% end %>

<p class="mt-6 text-slate-600">
  <%= t("session.new.no_account") %>
  <%= link_to t("auth.sign_up"), new_registration_path, class: "text-indigo-600 font-semibold min-h-11 inline-flex items-center" %>
</p>

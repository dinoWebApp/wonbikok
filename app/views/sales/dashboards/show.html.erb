<% content_for :title, t("sales.dashboard.title") %>

<div class="mb-6">
  <h1 class="text-xl font-extrabold tracking-tight"><%= t("sales.dashboard.title") %></h1>
  <p class="mt-1 text-sm text-muted"><%= t("sales.dashboard.scope_notice") %></p>
</div>

<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
  <%# ① 현재 유효 추천 코드(복사) — REF-001: 직원당 유효 1개·7일 %>
  <section class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-sm font-bold text-muted"><%= t("sales.dashboard.code_title") %></h2>
    <% if @code.present? %>
      <div data-controller="clipboard"
           data-clipboard-text-value="<%= @code.code %>"
           data-clipboard-success-message-value="<%= t("sales.dashboard.code_copied") %>"
           data-clipboard-fallback-message-value="<%= t("sales.dashboard.code_copy_fallback") %>"
           class="mt-3 space-y-2">
        <div class="flex items-center justify-between gap-3">
          <p data-clipboard-target="display" class="font-mono text-2xl font-extrabold tracking-[0.3em] text-brand-700"><%= @code.code %></p>
          <%= render "shared/button", label: t("sales.dashboard.code_copy"),
                variant: :secondary, type: "button", data: { action: "clipboard#copy" } %>
        </div>
        <p data-clipboard-target="toast" aria-live="polite" role="status"
           class="hidden rounded-lg bg-success-50 px-3 py-2 text-center text-xs font-semibold text-success-700"></p>
        <p class="text-xs text-muted">
          <%= t("sales.dashboard.code_expires", date: l(@code.expires_at, format: :short)) %>
        </p>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-muted"><%= t("sales.dashboard.code_missing") %></p>
    <% end %>
  </section>

  <%# ④ 이번달 수령 예상(전월 확정 결제 기준 — 월 후불 정산) %>
  <section class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-sm font-bold text-muted"><%= t("sales.dashboard.expected_title") %></h2>
    <p class="mt-3 text-3xl font-extrabold text-brand-700">
      <%= number_to_currency(@expected_amount, unit: "₩", precision: 0) %>
    </p>
    <p class="mt-2 text-xs leading-relaxed text-muted"><%= t("sales.dashboard.expected_formula") %></p>
    <p class="mt-1 text-xs text-muted"><%= t("sales.dashboard.rate_notice", rate: (current_sales_rep.effective_commission_rate * 100).round(1)) %></p>
  </section>
</div>

<%# ⑤ 연도별 누적 수수료(연도 선택·지급/미지급 구분) %>
<section class="mt-6 rounded-xl border border-line bg-surface p-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-sm font-bold text-muted"><%= t("sales.dashboard.yearly_title") %></h2>
    <%= form_with url: sales_dashboard_path, method: :get, class: "flex items-center gap-2" do |form| %>
      <%= form.select :year, (Date.current.year.downto(Date.current.year - Sales::DashboardsController::YEARS_BACK)).map { |y| ["#{y}#{t("sales.dashboard.year_suffix")}", y] },
            { selected: @selected_year },
            class: "rounded-lg border border-line bg-surface px-3 py-2 text-sm" %>
      <%= form.submit t("sales.dashboard.year_apply"), class: "rounded-lg bg-brand-600 px-3 py-2 text-sm font-bold text-white hover:bg-brand-700" %>
    <% end %>
  </div>
  <div class="mt-3 grid grid-cols-3 gap-3">
    <div class="rounded-lg bg-canvas p-3">
      <p class="text-xs text-muted"><%= t("sales.dashboard.yearly_total") %></p>
      <p class="mt-1 font-mono text-lg font-extrabold"><%= number_to_currency(@yearly.total_amount, unit: "₩", precision: 0) %></p>
    </div>
    <div class="rounded-lg bg-canvas p-3">
      <p class="text-xs text-muted"><%= t("sales.dashboard.yearly_paid") %></p>
      <p class="mt-1 font-mono text-lg font-extrabold text-success-700"><%= number_to_currency(@yearly.paid_amount, unit: "₩", precision: 0) %></p>
    </div>
    <div class="rounded-lg bg-canvas p-3">
      <p class="text-xs text-muted"><%= t("sales.dashboard.yearly_pending") %></p>
      <p class="mt-1 font-mono text-lg font-extrabold text-warning-700"><%= number_to_currency(@yearly.pending_amount, unit: "₩", precision: 0) %></p>
    </div>
  </div>
  <% if @yearly.rows.empty? %>
    <p class="mt-3 rounded-lg bg-canvas p-4 text-center text-sm text-muted"><%= t("sales.dashboard.no_ledgers") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[32rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-3 py-2"><%= t("sales.dashboard.col_month") %></th>
            <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_base") %></th>
            <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_commission") %></th>
            <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_paid") %></th>
            <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_pending") %></th>
          </tr>
        </thead>
        <tbody>
          <% @yearly.rows.each do |row| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-3 py-2"><%= row.month %></td>
              <td class="px-3 py-2 text-right font-mono"><%= number_to_currency(row.base_amount, unit: "₩", precision: 0) %></td>
              <td class="px-3 py-2 text-right font-mono font-bold"><%= number_to_currency(row.amount, unit: "₩", precision: 0) %></td>
              <td class="px-3 py-2 text-right font-mono text-success-700"><%= number_to_currency(row.paid_amount, unit: "₩", precision: 0) %></td>
              <td class="px-3 py-2 text-right font-mono text-warning-700"><%= number_to_currency(row.pending_amount, unit: "₩", precision: 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<%# ③ 월별 결제액(피판매 전체 — 실제 징수액, 선택 연도) %>
<section class="mt-6 rounded-xl border border-line bg-surface p-5">
  <h2 class="text-sm font-bold text-muted"><%= t("sales.dashboard.charged_title", year: @selected_year) %></h2>
  <p class="mt-1 text-xs text-muted"><%= t("sales.dashboard.charged_formula") %></p>
  <div class="mt-3 overflow-x-auto">
    <table class="w-full min-w-[24rem] text-sm">
      <thead>
        <tr class="border-b border-line text-left text-xs font-semibold text-muted">
          <th class="px-3 py-2"><%= t("sales.dashboard.col_month") %></th>
          <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_charged") %></th>
        </tr>
      </thead>
      <tbody>
        <% @monthly_charged_rows.each do |row| %>
          <tr class="border-b border-line last:border-b-0">
            <td class="px-3 py-2"><%= row.month %></td>
            <td class="px-3 py-2 text-right font-mono"><%= number_to_currency(row.total_amount, unit: "₩", precision: 0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<%# ② 피판매 사용자 목록(가입일·플랜·구독 상태 — 개인정보 미수집·TEN 준용) %>
<section class="mt-6 rounded-xl border border-line bg-surface p-5">
  <h2 class="text-sm font-bold text-muted"><%= t("sales.dashboard.tenants_title") %></h2>
  <p class="mt-1 text-xs text-muted"><%= t("sales.dashboard.tenants_privacy_notice") %></p>
  <% if @tenant_rows.empty? %>
    <p class="mt-3 rounded-lg bg-canvas p-4 text-center text-sm text-muted"><%= t("sales.dashboard.no_tenants") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[28rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-3 py-2"><%= t("sales.dashboard.col_tenant_name") %></th>
            <th class="px-3 py-2"><%= t("sales.dashboard.col_joined") %></th>
            <th class="px-3 py-2"><%= t("sales.dashboard.col_plan") %></th>
            <th class="px-3 py-2"><%= t("sales.dashboard.col_status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @tenant_rows.each do |row| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-3 py-2 font-semibold"><%= row.tenant_name %></td>
              <td class="px-3 py-2 text-muted"><%= l(row.joined_on, format: :default) %></td>
              <td class="px-3 py-2"><%= row.plan ? t("admin.subscription_statuses.plan.#{row.plan}") : t("sales.dashboard.no_subscription") %></td>
              <td class="px-3 py-2"><%= row.status ? t("admin.subscription_statuses.status.#{row.status}") : t("sales.dashboard.no_subscription") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

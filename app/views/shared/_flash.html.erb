<%# 플래시 — notice(성공·안내)/alert(오류) — 색상+아이콘+텍스트 병행 (PRD 16.2·15.4)
    사용: 레이아웃에서 render "shared/flash" %>
<% if notice.present? %>
  <div class="mb-4 flex items-start gap-2.5 rounded-xl border border-success-200 bg-success-50 px-4 py-3 text-sm text-success-700" role="status">
    <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" fill="currentColor" opacity="0.12"/>
      <path d="m8.6 12.2 2.4 2.4 4.6-4.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <p class="font-medium leading-relaxed"><%= notice %></p>
  </div>
<% end %>
<% if alert.present? %>
  <div class="mb-4 flex items-start gap-2.5 rounded-xl border border-danger-200 bg-danger-50 px-4 py-3 text-sm text-danger-700" role="alert">
    <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M10.6 3.7 2.7 17.4c-.8 1.3.2 3 1.7 3h15.2c1.5 0 2.5-1.7 1.7-3L13.4 3.7c-.7-1.3-2.1-1.3-2.8 0z" fill="currentColor" opacity="0.12"/>
      <path d="M12 9v4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <circle cx="12" cy="16.6" r="1.1" fill="currentColor"/>
    </svg>
    <p class="font-medium leading-relaxed"><%= alert %></p>
  </div>
<% end %>

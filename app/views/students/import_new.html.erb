<%= render "shared/page_header", title: t("students.import.title"),
      description: t("students.import.description") %>

<%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
  <%# 1단계: 양식 다운로드 %>
  <%= render "shared/button", label: t("students.import.download_template"),
        url: import_template_students_path, variant: :secondary, class: "w-full" %>
  <p class="-mt-2 text-xs leading-relaxed text-muted"><%= t("students.import.template_notice") %></p>

  <%# 2단계: 파일 업로드 %>
  <%= form_with url: import_students_path, method: :post, local: true, class: "space-y-3" do |form| %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :file,
          label_text: t("students.import.file_label"), required: true,
          hint: t("students.import.utf8_notice") } do %>
      <%= form.file_field :file, accept: ".csv,text/csv", required: true,
            class: "w-full text-sm text-ink file:mr-3 file:min-h-11 file:cursor-pointer file:rounded-lg file:border-0 file:bg-brand-50 file:px-4 file:text-sm file:font-semibold file:text-brand-700 hover:file:bg-brand-100" %>
    <% end %>
    <%= form.submit t("students.import.submit"), class: "btn-primary btn-lg w-full" %>
  <% end %>
<% end %>

<%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
  <p class="text-sm font-bold text-ink"><%= t("students.import.rules_title") %></p>
  <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-muted">
    <li><%= t("students.import.rules_required") %></li>
    <li><%= t("students.import.rules_fee") %></li>
    <li><%= t("students.import.rules_payment_day") %></li>
    <li><%= t("students.import.rules_types") %></li>
  </ul>
<% end %>

<div class="mt-4">
  <%= render "shared/button", label: t("common.back"), url: students_path, variant: :secondary, class: "w-full" %>
</div>

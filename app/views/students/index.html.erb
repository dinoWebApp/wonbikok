<%= render layout: "shared/page_header", locals: { title: t("students.index.title") } do %>
  <%= render "shared/button", label: t("students.import.title"),
        url: import_students_path, variant: :secondary, class: "hidden md:inline-flex" %>
  <%= render "shared/button", label: t("students.index.new"),
        url: new_student_path, variant: :primary %>
<% end %>

<%# 검색 — 원생명 + 전화 뒷자리(TEN-003: 뒷자리만 검색) %>
<%= form_with url: students_path, method: :get, local: true, class: "mb-3" do |form| %>
  <div class="flex gap-2">
    <%= form.text_field :q, value: params[:q], placeholder: t("students.index.search_name"),
          "aria-label": t("students.index.search_name"), class: "field-input flex-1" %>
    <%= form.text_field :phone_last4, value: params[:phone_last4], maxlength: 4, inputmode: "numeric",
          placeholder: t("students.index.search_phone_last4"),
          "aria-label": t("students.index.search_phone_last4"), class: "field-input w-28 shrink-0" %>
    <%= form.submit t("students.index.search"), class: "btn-secondary shrink-0" %>
  </div>
<% end %>

<%# 상태 필터 칩 — 현재 필터는 브랜드색+텍스트로 표시 %>
<div class="mb-4 flex gap-2 text-sm">
  <% [ [ nil, t("students.filter.all") ], %w[active 재원], %w[paused 휴원], %w[withdrawn 퇴원] ].each do |status, label| %>
    <% active_filter = params[:status].presence == status %>
    <%= link_to label, students_path(request.query_parameters.except("status").merge(status: status)),
          class: "inline-flex min-h-11 items-center rounded-full border px-4 #{active_filter ? 'border-brand-600 bg-brand-600 text-white font-semibold' : 'border-line bg-surface text-muted'}" %>
  <% end %>
</div>

<% if @students.any? %>
  <%# 카드형 목록 — 모바일 퍼스트 (레퍼런스: 토스증권 목록 카드) %>
  <ul class="space-y-3">
    <% @students.each do |student| %>
      <li>
        <%= link_to student_path(student),
              class: "block rounded-xl border border-line bg-surface p-4 transition-colors hover:border-brand-200" do %>
          <div class="flex items-start justify-between gap-2">
            <span class="min-w-0 truncate text-base font-bold text-ink"><%= student.name %></span>
            <div class="flex shrink-0 items-center gap-1">
              <% if @sibling_student_ids.include?(student.id) %>
                <%= render "shared/badge", tone: :info, text: t("students.badges.sibling") %>
              <% end %>
              <% student_tone = { "active" => :success, "paused" => :warning }.fetch(student.status, :neutral) %>
              <%= render "shared/badge", tone: student_tone, text: t("students.status.#{student.status}") %>
            </div>
          </div>
          <div class="mt-1.5 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-sm text-muted">
            <span class="min-w-0 truncate">
              <% guardian = student.primary_guardian %>
              <% if guardian %>
                <%= guardian.name %> · <%= masked_phone(guardian.phone_number) %>
              <% end %>
              <% if student.grade.present? %> · <%= student.grade %><% end %>
            </span>
            <%# 금액: 오른쪽 정렬 + tabular-nums (PRD 16.1) %>
            <span class="shrink-0 font-semibold tabular-nums text-ink">
              <%= number_with_delimiter(student.monthly_fee) %><%= t("students.index.won") %>
            </span>
          </div>
          <%# 이번 달 상태: 청구 기능(W3 F4/F5) 제공 전 대기 고정 — 핀 모티프 대기 표시 %>
          <div class="mt-2">
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21.5s-7.5-5.6-7.5-11a7.5 7.5 0 1 1 15 0c0 5.4-7.5 11-7.5 11z" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="10.5" r="1.6" fill="currentColor"/>
              </svg>
              <%= t("students.badges.month_waiting") %>
            </span>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state", title: t("students.index.empty"),
        cta_label: t("students.index.new"), cta_url: new_student_path,
        secondary_label: t("students.import.title"), secondary_url: import_students_path %>
<% end %>

<%# 모바일: 헤더 액션이 좁아 CSV 등록은 목록 하단 보조 진입 (md 미만 표시) %>
<div class="mt-4 md:hidden">
  <%= render "shared/button", label: t("students.import.title"),
        url: import_students_path, variant: :secondary, class: "w-full" %>
</div>

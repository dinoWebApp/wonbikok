<%= form_with model: student,
      url: confirm ? students_path(confirm: "1") : (student.persisted? ? student_path(student) : students_path),
      class: "space-y-4" do |form| %>
  <% if student.errors.any? %>
    <%# 폼 오류 요약 — 색상+아이콘+텍스트 (PRD 16.2) %>
    <div class="rounded-xl border border-danger-200 bg-danger-50 px-4 py-3 text-sm text-danger-700" role="alert">
      <p class="font-semibold"><%= t("errors.form") %></p>
      <ul class="mt-1 list-disc pl-4">
        <% student.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :name,
          label_text: Student.human_attribute_name(:name), required: true } do %>
      <%= form.text_field :name, required: true, class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :grade,
          label_text: Student.human_attribute_name(:grade) } do %>
      <%= form.text_field :grade, placeholder: t("students.form.grade_placeholder"),
            class: "field-input" %>
    <% end %>
    <div class="grid grid-cols-2 gap-3">
      <%= render layout: "shared/form_field", locals: { form: form, attr: :monthly_fee,
            label_text: Student.human_attribute_name(:monthly_fee), class: "" } do %>
        <%= form.number_field :monthly_fee, min: 0, step: 1000,
              class: "field-input text-right tabular-nums" %>
      <% end %>
      <%= render layout: "shared/form_field", locals: { form: form, attr: :payment_day,
            label_text: Student.human_attribute_name(:payment_day) } do %>
        <%= form.number_field :payment_day, min: 1, max: 28,
              class: "field-input text-right tabular-nums" %>
      <% end %>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <%= render layout: "shared/form_field", locals: { form: form, attr: :payment_type,
            label_text: Student.human_attribute_name(:payment_type) } do %>
        <%= form.select :payment_type, Student.payment_types.keys.map { |key| [ t("students.payment_type.#{key}"), key ] }, {},
              class: "field-input" %>
      <% end %>
      <% if student.persisted? %>
        <%= render layout: "shared/form_field", locals: { form: form, attr: :status,
              label_text: Student.human_attribute_name(:status) } do %>
          <%= form.select :status, Student.statuses.keys.map { |key| [ t("students.status.#{key}"), key ] }, {},
                class: "field-input" %>
        <% end %>
      <% end %>
    </div>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :started_on,
          label_text: Student.human_attribute_name(:started_on) } do %>
      <%= form.date_field :started_on, class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :memo,
          label_text: Student.human_attribute_name(:memo) } do %>
      <%= form.text_area :memo, rows: 2,
            class: "w-full rounded-lg border border-line bg-surface px-3 py-2 text-base text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" %>
    <% end %>
  <% end %>

  <% guardian = student.guardians.first || student.guardians.build %>
  <%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
    <p class="text-sm font-bold text-ink"><%= t("students.form.guardian_section") %></p>
    <%= fields_for "student[guardians_attributes][]", guardian do |guardian_form| %>
      <%= guardian_form.hidden_field :id %>
      <%= render layout: "shared/form_field", locals: { form: guardian_form, attr: :name,
            label_text: Guardian.human_attribute_name(:name), required: true } do %>
        <%= guardian_form.text_field :name, class: "field-input" %>
      <% end %>
      <%= render layout: "shared/form_field", locals: { form: guardian_form, attr: :phone_number,
            label_text: Guardian.human_attribute_name(:phone_number), required: true,
            hint: t("students.form.phone_notice") } do %>
        <%= guardian_form.telephone_field :phone_number, inputmode: "numeric",
              placeholder: "01012345678", class: "field-input" %>
      <% end %>
    <% end %>
  <% end %>

  <div class="flex gap-2">
    <%= form.submit t("common.save"), class: "btn-primary btn-lg flex-1" %>
    <%= link_to t("common.cancel"), student.persisted? ? student_path(student) : students_path,
          class: "btn-secondary btn-lg" %>
  </div>
<% end %>

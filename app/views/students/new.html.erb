<%= render layout: "shared/page_header", locals: { title: t("students.form.title_new") } do %>
  <%= render "shared/button", label: t("common.cancel"), url: students_path, variant: :secondary %>
<% end %>

<% if @conflicts.present? %>
  <%# 중복 의심 안내 — 주의 톤 + 텍스트 (PRD 16.2, 조치 필요 아님·주의) %>
  <div class="mb-4 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm text-warning-700" role="status">
    <p class="font-semibold"><%= t("students.form.conflict_title") %></p>
    <ul class="mt-1 list-disc pl-4">
      <% @conflicts.each do |conflict| %>
        <li><%= link_to conflict.name, student_path(conflict), class: "font-semibold underline underline-offset-2" %> (<%= t("students.status.#{conflict.status}") %>)</li>
      <% end %>
    </ul>
    <p class="mt-1 leading-relaxed"><%= t("students.form.conflict_notice") %></p>
  </div>
<% end %>

<%= render "form", student: @student, confirm: @conflicts.present? %>

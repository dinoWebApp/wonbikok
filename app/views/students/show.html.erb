<%= render layout: "shared/page_header", locals: { title: t("students.show.title") } do %>
  <%= render "shared/button", label: t("common.back"), url: students_path, variant: :secondary %>
<% end %>

<% if @sibling_students.any? %>
  <%# 형제·자매 안내 — info 톤 + 텍스트 (PRD 16.2) %>
  <div class="mb-4 rounded-xl border border-info-100 bg-info-50 px-4 py-3 text-sm">
    <p class="font-semibold text-info-700"><%= t("students.badges.sibling") %>: <%= @sibling_students.map(&:name).join(", ") %></p>
    <p class="mt-1 leading-relaxed text-info-700 opacity-90"><%= t("students.show.sibling_notice") %></p>
  </div>
<% end %>

<%= render layout: "shared/card", locals: { class: "p-5" } do %>
  <div class="flex items-start justify-between gap-2">
    <span class="min-w-0 text-lg font-bold text-ink"><%= @student.name %></span>
    <div class="flex shrink-0 items-center gap-1">
      <% student_tone = { "active" => :success, "paused" => :warning }.fetch(@student.status, :neutral) %>
      <%= render "shared/badge", tone: student_tone, text: t("students.status.#{@student.status}") %>
      <%# 이번 달 상태: 청구 기능(W3 F4/F5) 제공 전 대기 고정 — 핀 모티프 대기 표시 %>
      <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 21.5s-7.5-5.6-7.5-11a7.5 7.5 0 1 1 15 0c0 5.4-7.5 11-7.5 11z" stroke="currentColor" stroke-width="2"/>
          <circle cx="12" cy="10.5" r="1.6" fill="currentColor"/>
        </svg>
        <%= t("students.badges.month_waiting") %>
      </span>
    </div>
  </div>

  <dl class="mt-3 text-sm">
    <% rows = [
         [ t("activerecord.attributes.student.grade"), @student.grade.presence || "-", false ],
         [ t("activerecord.attributes.student.monthly_fee"), "#{number_with_delimiter(@student.monthly_fee)}#{t('students.index.won')}", true ],
         [ t("activerecord.attributes.student.payment_day"), t("students.show.payment_day_of_month", day: @student.payment_day), false ],
         [ t("activerecord.attributes.student.payment_type"), t("students.payment_type.#{@student.payment_type}"), false ]
       ] %>
    <% rows.each do |term, value, numeric| %>
      <div class="flex justify-between gap-4 border-b border-line py-2.5 last:border-b-0">
        <dt class="shrink-0 text-muted"><%= term %></dt>
        <% if numeric %>
          <%# 금액: 오른쪽 정렬 + tabular-nums (PRD 16.1) %>
          <dd class="text-right font-semibold tabular-nums text-ink"><%= value %></dd>
        <% else %>
          <dd class="text-right font-medium text-ink"><%= value %></dd>
        <% end %>
      </div>
    <% end %>
    <div class="flex justify-between gap-4 border-b border-line py-2.5">
      <dt class="shrink-0 text-muted"><%= t("students.show.guardian") %></dt>
      <dd class="text-right font-medium text-ink">
        <% guardian = @student.primary_guardian %>
        <% if guardian %>
          <%= guardian.name %> · <%= masked_phone(guardian.phone_number) %>
        <% end %>
      </dd>
    </div>
    <% if @student.started_on.present? %>
      <div class="flex justify-between gap-4 border-b border-line py-2.5">
        <dt class="shrink-0 text-muted"><%= t("activerecord.attributes.student.started_on") %></dt>
        <dd class="text-right font-medium tabular-nums text-ink"><%= l(@student.started_on) %></dd>
      </div>
    <% end %>
    <% if @student.ended_on.present? %>
      <div class="flex justify-between gap-4 border-b border-line py-2.5">
        <dt class="shrink-0 text-muted"><%= t("activerecord.attributes.student.ended_on") %></dt>
        <dd class="text-right font-medium tabular-nums text-ink"><%= l(@student.ended_on) %></dd>
      </div>
    <% end %>
    <% if @student.memo.present? %>
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="shrink-0 text-muted"><%= t("activerecord.attributes.student.memo") %></dt>
        <dd class="max-w-[60%] text-right leading-relaxed text-ink"><%= @student.memo %></dd>
      </div>
    <% end %>
  </dl>
<% end %>

<%# 이번 달 납부·발행 이력: 청구 기능(W3 F4/F5) 제공 전 빈 상태 안내 (PRD 15.4) %>
<div class="mt-4">
  <%= render "shared/empty_state", title: t("students.show.history_title"),
        description: t("students.show.history_empty"), class: "px-6 py-8" %>
</div>

<div class="mt-6 flex flex-wrap gap-2">
  <%= render "shared/button", label: t("common.edit"), url: edit_student_path(@student), variant: :secondary %>
  <% if @student.status_active? %>
    <%= render "shared/button", label: t("students.actions.pause"),
          url: pause_student_path(@student), method: :patch, variant: :warning_secondary %>
    <%= render "shared/button", label: t("students.actions.withdraw"),
          url: withdraw_student_path(@student), method: :patch, variant: :destructive_secondary %>
  <% else %>
    <%= render "shared/button", label: t("students.actions.restore"),
          url: restore_student_path(@student), method: :patch, variant: :secondary %>
  <% end %>
</div>

<%= render "shared/page_header", title: t("students.import.result_title") %>

<%# 결과 요약 — 성공/실패 수를 색상+텍스트로 구분 (PRD 16.2) %>
<%= render layout: "shared/card", locals: { class: "p-5" } do %>
  <div class="grid grid-cols-2 gap-3">
    <div class="rounded-lg bg-success-50 px-4 py-3">
      <p class="text-sm font-semibold text-success-700"><%= t("students.import.success", count: @result.success_count) %></p>
    </div>
    <div class="rounded-lg bg-danger-50 px-4 py-3 text-right">
      <p class="text-sm font-semibold tabular-nums text-danger-700"><%= t("students.import.failed", count: @result.errors.size) %></p>
    </div>
  </div>
<% end %>

<% if @result.errors.any? %>
  <div class="mt-4 rounded-xl border border-danger-200 bg-surface p-5">
    <h2 class="text-sm font-bold text-ink"><%= t("students.import.error_detail_title") %></h2>
    <ul class="mt-2 space-y-1.5 text-sm">
      <% @result.errors.each do |error| %>
        <li class="text-danger-700">
          <span class="font-semibold tabular-nums"><%= t("students.import.error_line", line: error.line) %></span>: <%= error.reasons.join(" / ") %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="mt-4 space-y-2">
    <%= render "shared/button", label: t("students.import.download_errors"),
          url: import_errors_students_path, variant: :destructive_secondary, class: "w-full" %>
    <p class="text-xs leading-relaxed text-muted"><%= t("students.import.errors_reupload_notice") %></p>
  </div>
<% else %>
  <div class="mt-4">
    <%= render "shared/button", label: t("students.import.back_to_list"),
          url: students_path, variant: :primary, size: :lg, class: "w-full" %>
  </div>
<% end %>

<%# 월간 마감 리포트 (W4 F7 — PRD 7장 F7): 납부율·미납 명단·발행 요약.
    PDF 저장은 후속 과제(_workspace/01_plan.md §0.2 — Node/npm 없는 스택에서 PDF 젬 선정·
    플랜 게이팅이 F8 상태 의존) — 본 화면은 HTML 리포트만 제공한다.
    라우트는 3-S 통합에서 추가(get "dashboard/report") — f7 단계에서는 링크 없음. %>
<%= render layout: "shared/page_header", locals: { title: t("dashboard.report.title", month: @month) } do %>
  <%= render "shared/button", label: t("common.back"), url: dashboard_path(month: @month), variant: :secondary %>
<% end %>

<%# 지표 요약 — 대시보드와 동일 집계(Dashboard::SummaryService — 수치 정합 보장) %>
<%= render layout: "shared/card", locals: { class: "p-5" } do %>
  <p class="text-sm font-bold text-ink"><%= t("dashboard.report.metrics_title") %></p>
  <dl class="mt-3 text-sm">
    <% metric_rows = [
         [ t("dashboard.metrics.billed"), "#{number_with_delimiter(@summary.billed_amount)}#{t('invoices.won')}" ],
         [ t("dashboard.metrics.paid"), "#{number_with_delimiter(@summary.paid_amount)}#{t('invoices.won')}" ],
         [ t("dashboard.metrics.unpaid"), "#{number_with_delimiter(@summary.unpaid_amount)}#{t('invoices.won')}" ],
         [ t("dashboard.metrics.rate"), @summary.payment_rate.nil? ? "-" : "#{@summary.payment_rate}%" ]
       ] %>
    <% metric_rows.each do |term, value| %>
      <div class="flex justify-between gap-4 border-b border-line py-2.5 last:border-b-0">
        <dt class="shrink-0 text-muted"><%= term %></dt>
        <dd class="text-right font-semibold tabular-nums text-ink"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-3 text-xs leading-relaxed text-muted">
    <%= t("dashboard.metrics.basis_label") %> <%= t("dashboard.metrics.basis_billed") %> · <%= t("dashboard.metrics.basis_paid") %>
  </p>
<% end %>

<%# 미납 명단 — 원생명·금액(잔액). 부분납 잔액 포함(INV-005), 취소 청구 제외(INV-003) %>
<%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
  <p class="text-sm font-bold text-ink">
    <%= t("dashboard.report.unpaid_title") %>
    <span class="ml-1 text-xs font-semibold text-muted"><%= @summary.unpaid_list.size %><%= t("invoices.summary.people") %></span>
  </p>
  <% if @summary.unpaid_list.empty? %>
    <p class="mt-3 text-sm leading-relaxed text-muted"><%= t("dashboard.report.unpaid_empty") %></p>
  <% else %>
    <dl class="mt-3 text-sm">
      <% @summary.unpaid_list.each do |entry| %>
        <div class="border-b border-line py-2.5 last:border-b-0">
          <div class="flex justify-between gap-4">
            <span class="min-w-0 truncate font-medium text-ink"><%= entry.student_name %></span>
            <span class="shrink-0 font-semibold tabular-nums text-warning-700">
              <%= number_with_delimiter(entry.balance) %><%= t("invoices.won") %>
            </span>
          </div>
          <p class="mt-0.5 text-right text-xs tabular-nums text-muted">
            <%= t("dashboard.report.unpaid_row_note",
                  total: number_with_delimiter(entry.total_amount),
                  paid: number_with_delimiter(entry.paid_amount)) %>
          </p>
        </div>
      <% end %>
    </dl>
    <div class="mt-3 flex justify-between gap-4 text-sm">
      <span class="font-bold text-ink"><%= t("dashboard.report.unpaid_total") %></span>
      <span class="font-bold tabular-nums text-warning-700">
        <%= number_with_delimiter(@summary.unpaid_list.sum(&:balance)) %><%= t("invoices.won") %>
      </span>
    </div>
  <% end %>
<% end %>

<%# 발행 요약 — 상태별 건수(7종 전체 — 리포트 완결성, 대시보드 지표와 동일 집계) %>
<%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
  <p class="text-sm font-bold text-ink"><%= t("dashboard.report.receipt_title") %></p>
  <% state_tones = { "issued" => :success, "pending" => :info, "processing" => :info,
                     "failed" => :danger, "needs_info" => :warning,
                     "cancel_pending" => :warning, "cancelled" => :neutral } %>
  <dl class="mt-3 text-sm">
    <% @summary.receipt_state_counts.each do |state, count| %>
      <div class="flex justify-between gap-4 border-b border-line py-2.5 last:border-b-0">
        <dt><%= render "shared/badge", tone: state_tones.fetch(state, :neutral), text: t("cash_receipts.state.#{state}") %></dt>
        <dd class="font-semibold tabular-nums text-ink"><%= count %><%= t("dashboard.report.receipt_unit") %></dd>
      </div>
    <% end %>
  </dl>
<% end %>

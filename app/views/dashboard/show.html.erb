<%= render "shared/page_header", title: t("dashboard.title"),
      description: current_tenant.name %>

<% if @summary.empty_state %>
  <%# 빈 상태 — 데이터 없는 첫 사용자는 빈 그래프 대신 단계 안내 (PRD 7장 F7) %>
  <div class="mt-4">
    <% if @summary.empty_state == :no_students %>
      <%= render "shared/empty_state", title: t("dashboard.empty.no_students_title"),
            description: t("dashboard.empty.no_students_description"),
            cta_label: t("dashboard.empty.no_students_cta"), cta_url: new_student_path %>
    <% else %>
      <%= render "shared/empty_state", title: t("dashboard.empty.no_invoices_title"),
            description: t("dashboard.empty.no_invoices_description"),
            cta_label: t("dashboard.empty.no_invoices_cta"), cta_url: invoices_path %>
    <% end %>
  </div>
<% else %>
  <% unissued_display_limit = 5 %>

  <%# ① 오늘 할 일 — 통계보다 상단 노출 (F7 수용조건: '남은 처리' 우선).
      미확인 입금은 payments 미확인 리스트와, 발행 실패는 cash_receipts 필터와 수가 일치한다. %>
  <%= render layout: "shared/card", locals: { class: "p-5" } do %>
    <p class="text-sm font-bold text-ink"><%= t("dashboard.todo_title") %></p>
    <dl class="mt-3 grid grid-cols-2 gap-3">
      <div class="rounded-lg bg-warning-50 px-3 py-2.5">
        <dt class="text-xs font-medium text-warning-700"><%= t("dashboard.todo.unconfirmed_payments") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-warning-700">
          <%= link_to "#{@summary.unconfirmed_payments_count}#{t('invoices.summary.people')}",
                payments_path, class: "hover:underline" %>
        </dd>
      </div>
      <div class="rounded-lg bg-danger-50 px-3 py-2.5">
        <dt class="text-xs font-medium text-danger-700"><%= t("dashboard.todo.failed_receipts") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-danger-700">
          <%= link_to "#{@summary.failed_receipts_count}#{t("dashboard.todo.unit_cases")}",
                cash_receipts_path, class: "hover:underline" %>
        </dd>
      </div>
      <div class="col-span-2 rounded-lg bg-info-50 px-3 py-2.5">
        <dt class="text-xs font-medium text-info-700"><%= t("dashboard.upcoming_reminders") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-info-700">
          <%= link_to "#{@summary.upcoming_reminders_count}#{t('invoices.summary.people')}",
                reminders_path, class: "hover:underline" %>
        </dd>
        <% if @summary.upcoming_reminders.any? %>
          <%# 기한 임박 순 상위(읽기 전용 스냅샷 — SummaryService 제공) %>
          <ul class="mt-2 space-y-1 text-xs text-info-700">
            <% @summary.upcoming_reminders.each do |reminder| %>
              <li class="flex items-center justify-between gap-2">
                <span class="min-w-0 truncate font-medium"><%= reminder.student_name %></span>
                <span class="shrink-0 tabular-nums">
                  <%= reminder.due_on.strftime("%-m/%-d") %>
                  <% if reminder.days_overdue.positive? %>
                    · <%= t("dashboard.todo.overdue_days", days: reminder.days_overdue) %>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </dl>
    <p class="mt-2 text-xs leading-relaxed text-muted"><%= t("dashboard.amount_basis") %></p>
  <% end %>

  <% if @summary.unissued_students.any? %>
    <%# ② 미발행 잔여 경고 — 납부 확인됐으나 발행되지 않은 원생 상단 노출.
        월말(말일 7일 이내)에는 가산세 방지 문구와 함께 강한 경고색 (PRD 7장 F7) %>
    <% unissued_urgent = @summary.month_end_near? %>
    <div class="mt-4 rounded-xl border <%= unissued_urgent ? "border-danger-300 bg-danger-50" : "border-warning-200 bg-warning-50" %> px-4 py-3">
      <p class="text-sm font-bold <%= unissued_urgent ? "text-danger-700" : "text-warning-700" %>">
        <%= t("dashboard.unissued.title") %> <%= @summary.unissued_students.size %><%= t("invoices.summary.people") %>
      </p>
      <p class="mt-1 text-xs leading-relaxed <%= unissued_urgent ? "text-danger-700" : "text-warning-700" %> opacity-90">
        <%= t("dashboard.unissued.description") %>
      </p>
      <ul class="mt-2 space-y-1 text-sm <%= unissued_urgent ? "text-danger-700" : "text-warning-700" %>">
        <% @summary.unissued_students.first(unissued_display_limit).each do |entry| %>
          <li class="flex items-center justify-between gap-2">
            <span class="min-w-0 truncate font-medium"><%= entry.student_name %></span>
            <span class="shrink-0 font-semibold tabular-nums">
              <%= number_with_delimiter(entry.total_amount) %><%= t("invoices.won") %>
            </span>
          </li>
        <% end %>
      </ul>
      <% if @summary.unissued_students.size > unissued_display_limit %>
        <p class="mt-1 text-xs <%= unissued_urgent ? "text-danger-700" : "text-warning-700" %> opacity-80">
          <%= t("dashboard.unissued.more", count: @summary.unissued_students.size - unissued_display_limit) %>
        </p>
      <% end %>
      <% if unissued_urgent %>
        <p class="mt-2 text-xs font-semibold leading-relaxed text-danger-700">
          <%= t("dashboard.unissued.month_end_notice") %>
        </p>
      <% end %>
      <%= render "shared/button", label: t("dashboard.unissued.action"),
            url: cash_receipts_path, variant: :secondary, class: "mt-3 w-full" %>
    </div>
  <% end %>

  <%# ③ 이번 달 지표 — 4개 이내, 금액 기준 라벨 병기 (F7: 기준을 화면에 명시).
      리포트 진입: 월간 마감 리포트(HTML) — 같은 SummaryService 집계(수치 정합) %>
  <%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
    <div class="flex items-center justify-between gap-2">
      <p class="text-sm font-bold text-ink"><%= t("dashboard.metrics.title", month: @month) %></p>
      <%= link_to t("dashboard.report_link"), dashboard_report_path(month: @month),
            class: "shrink-0 text-xs font-semibold text-brand-700 hover:underline" %>
    </div>
    <dl class="mt-3 grid grid-cols-2 gap-3">
      <div class="rounded-lg bg-canvas px-3 py-2.5">
        <dt class="text-xs text-muted"><%= t("dashboard.metrics.billed") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-ink">
          <%= number_with_delimiter(@summary.billed_amount) %><%= t("invoices.won") %>
        </dd>
      </div>
      <div class="rounded-lg bg-canvas px-3 py-2.5">
        <dt class="text-xs text-muted"><%= t("dashboard.metrics.paid") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-ink">
          <%= number_with_delimiter(@summary.paid_amount) %><%= t("invoices.won") %>
        </dd>
      </div>
      <div class="rounded-lg bg-warning-50 px-3 py-2.5">
        <dt class="text-xs font-medium text-warning-700"><%= t("dashboard.metrics.unpaid") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-warning-700">
          <%= number_with_delimiter(@summary.unpaid_amount) %><%= t("invoices.won") %>
        </dd>
      </div>
      <div class="rounded-lg bg-brand-50 px-3 py-2.5">
        <dt class="text-xs font-medium text-brand-700"><%= t("dashboard.metrics.rate") %></dt>
        <dd class="mt-0.5 text-lg font-bold tabular-nums text-brand-700">
          <%# 청구 0인 달은 납부율 미표시(데이터 없음) %>
          <%= @summary.payment_rate.nil? ? "-" : "#{@summary.payment_rate}%" %>
        </dd>
      </div>
    </dl>
    <% if @summary.draft_count.positive? %>
      <p class="mt-2 text-xs leading-relaxed text-muted">
        <%= t("dashboard.metrics.draft_note", count: @summary.draft_count) %>
      </p>
    <% end %>
    <p class="mt-2 text-xs leading-relaxed text-muted">
      <%= t("dashboard.metrics.basis_label") %> <%= t("dashboard.metrics.basis_billed") %> · <%= t("dashboard.metrics.basis_paid") %>
    </p>
  <% end %>

  <%# ④ 빠른 작업 — 청구 만들기·미납자 목록·발행 실패·원생 추가 (PRD 7장 F7) %>
  <%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
    <p class="text-sm font-bold leading-relaxed text-ink"><%= t("dashboard.ready") %></p>
    <%= render "shared/button", label: t("dashboard.invoices_link"),
          url: invoices_path, variant: :primary, size: :lg, class: "mt-4 w-full" %>
    <div class="mt-2 grid grid-cols-2 gap-2">
      <%= render "shared/button", label: t("dashboard.quick.unpaid_list"),
            url: payments_path, variant: :secondary %>
      <%= render "shared/button", label: t("dashboard.quick.failed_receipts"),
            url: cash_receipts_path, variant: :secondary %>
      <%= render "shared/button", label: t("dashboard.quick.new_student"),
            url: new_student_path, variant: :secondary %>
      <%= render "shared/button", label: t("dashboard.students_link"),
            url: students_path, variant: :secondary %>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-muted"><%= t("dashboard.invoices_hint") %></p>
  <% end %>

  <%# ⑤ 마감 완료 표시 — 수납 100% 또는 월 경과 도달 (F7 수용조건) %>
  <% if @summary.closing_complete? %>
    <div class="mt-4 rounded-xl border border-success-200 bg-success-50 px-4 py-3">
      <p class="text-sm font-bold text-success-700"><%= t("dashboard.closing.title") %></p>
      <p class="mt-1 text-xs leading-relaxed text-success-700 opacity-90">
        <%= t("dashboard.closing.description") %>
      </p>
    </div>
  <% end %>
<% end %>

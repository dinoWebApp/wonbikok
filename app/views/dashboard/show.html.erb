<%= render "shared/page_header", title: t("dashboard.title"),
      description: current_tenant.name %>

<%# 오늘 할 일 — 미납 요약·다가오는 리마인더 (F6/F7 경계: W2는 요약+링크) %>
<%= render layout: "shared/card", locals: { class: "p-5" } do %>
  <p class="text-sm font-bold text-ink"><%= t("dashboard.todo_title") %></p>
  <dl class="mt-3 grid grid-cols-2 gap-3">
    <div class="rounded-lg bg-warning-50 px-3 py-2.5">
      <dt class="text-xs font-medium text-warning-700"><%= t("dashboard.unpaid_count") %></dt>
      <dd class="mt-0.5 text-lg font-bold tabular-nums text-warning-700">
        <%= link_to "#{@unpaid_count}#{t('invoices.summary.people')}", reminders_path, class: "hover:underline" %>
        <span class="text-sm font-semibold">(<%= number_with_delimiter(@unpaid_total) %><%= t("invoices.won") %>)</span>
      </dd>
    </div>
    <div class="rounded-lg bg-info-50 px-3 py-2.5">
      <dt class="text-xs font-medium text-info-700"><%= t("dashboard.upcoming_reminders") %></dt>
      <dd class="mt-0.5 text-lg font-bold tabular-nums text-info-700">
        <%= link_to "#{@upcoming_reminders}#{t('invoices.summary.people')}", reminders_path, class: "hover:underline" %>
      </dd>
    </div>
  </dl>
  <p class="mt-2 text-xs leading-relaxed text-muted"><%= t("dashboard.amount_basis") %></p>
<% end %>

<%# 이번 달 마감 — 우선 CTA: 이번 달 청구 만들기 (PRD 16.4) %>
<%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
  <p class="text-sm font-bold leading-relaxed text-ink"><%= t("dashboard.ready") %></p>
  <%= render "shared/button", label: t("dashboard.invoices_link"),
        url: invoices_path, variant: :primary, size: :lg, class: "mt-4 w-full" %>
  <div class="mt-2 grid grid-cols-2 gap-2">
    <%= render "shared/button", label: t("dashboard.students_link"),
          url: students_path, variant: :secondary %>
    <%= render "shared/button", label: t("dashboard.reminders_link"),
          url: reminders_path, variant: :secondary %>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted"><%= t("dashboard.invoices_hint") %></p>
<% end %>

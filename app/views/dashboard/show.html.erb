<h1 class="text-xl font-bold mb-4"><%= t("dashboard.title") %></h1>

<%# 오늘 할 일 — 미납 요약·다가오는 리마인더 (F6/F7 경계: W2는 요약+링크) %>
<div class="rounded-xl border border-slate-200 bg-white p-5 mb-4">
  <p class="font-semibold"><%= t("dashboard.todo_title") %></p>
  <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
    <div>
      <dt class="text-slate-500"><%= t("dashboard.unpaid_count") %></dt>
      <dd class="font-semibold">
        <%= link_to "#{@unpaid_count}#{t('invoices.summary.people')}", reminders_path, class: "text-blue-600" %>
        <span class="text-slate-500">(<%= number_with_delimiter(@unpaid_total) %><%= t("invoices.won") %>)</span>
      </dd>
    </div>
    <div>
      <dt class="text-slate-500"><%= t("dashboard.upcoming_reminders") %></dt>
      <dd class="font-semibold">
        <%= link_to "#{@upcoming_reminders}#{t('invoices.summary.people')}", reminders_path, class: "text-blue-600" %>
      </dd>
    </div>
  </dl>
  <p class="mt-2 text-xs text-slate-500"><%= t("dashboard.amount_basis") %></p>
</div>

<div class="rounded-xl border border-slate-200 bg-white p-5">
  <p class="font-semibold"><%= t("dashboard.ready") %></p>
  <%= link_to t("dashboard.students_link"), students_path,
        class: "mt-4 min-h-11 px-4 inline-flex items-center rounded-lg bg-slate-900 text-white text-sm font-semibold" %>
  <%= link_to invoices_path,
        class: "mt-2 min-h-11 px-4 inline-flex items-center rounded-lg border border-slate-300 bg-white text-sm font-semibold" do %>
    <%= t("dashboard.invoices_link") %>
  <% end %>
  <%= link_to t("dashboard.reminders_link"), reminders_path,
        class: "mt-2 min-h-11 px-4 inline-flex items-center rounded-lg border border-slate-300 bg-white text-sm font-semibold" %>
  <p class="mt-2 text-xs text-slate-500"><%= t("dashboard.invoices_hint") %></p>
</div>

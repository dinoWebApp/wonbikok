<%# 6. 사용 시연 — 상상을 체험으로 (PRD 13.2)
    시연 GIF/영상 부재 → 정적 4스텝 모형(CSS) + 준비 중 안내 (13.4 — 미제공 표기) %>
<section class="border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-ink md:text-3xl"><%= t("landing.demo.title") %></h2>
    <p class="mt-3 text-base leading-relaxed text-muted"><%= t("landing.demo.subtitle") %></p>

    <%# 정적 4스텝 모형 — "체크 → 발행 완료 알림톡 도착" 스토리 %>
    <div class="mt-8 grid gap-4 md:grid-cols-4 md:gap-5" role="img"
         aria-label="<%= t("landing.demo.mockup_aria") %>">
      <% 1.upto(4) do |i| %>
        <%= render layout: "shared/card", locals: { class: "p-5" } do %>
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white" aria-hidden="true"><%= i %></span>
          <% if i == 1 %>
            <%# 스텝 1 — 미납 리스트 확인 %>
            <div class="mt-4 flex items-center justify-between gap-2 rounded-lg border border-line bg-canvas px-3 py-2">
              <span class="text-sm font-semibold text-ink"><%= t("landing.demo.mockup_name") %></span>
              <span class="rounded-full border border-warning-200 bg-warning-50 px-2 py-0.5 text-xs font-semibold text-warning-700"><%= t("landing.demo.mockup_unpaid") %></span>
            </div>
          <% elsif i == 2 %>
            <%# 스텝 2 — 체크 한 번 %>
            <div class="mt-4 flex items-center justify-center gap-2 rounded-lg border border-brand-200 bg-brand-50 px-3 py-2">
              <svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
              <span class="text-sm font-bold text-brand-700"><%= t("landing.demo.mockup_check") %></span>
            </div>
          <% elsif i == 3 %>
            <%# 스텝 3 — 현금영수증 자동 발행 %>
            <div class="mt-4 rounded-lg border border-line bg-canvas px-3 py-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-bold text-ink"><%= t("landing.demo.mockup_receipt") %></span>
                <span class="inline-flex items-center gap-1 rounded-full border border-success-200 bg-success-50 px-2 py-0.5 text-xs font-semibold text-success-700">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
                  <%= t("landing.demo.mockup_receipt_done") %>
                </span>
              </div>
            </div>
          <% else %>
            <%# 스텝 4 — 학부모 발행 완료 알림톡 도착 %>
            <div class="mt-4 rounded-lg rounded-tl-sm border border-line bg-canvas px-3 py-2">
              <p class="text-xs font-bold text-ink"><%= t("landing.demo.mockup_alimtalk") %></p>
              <p class="mt-1 text-xs leading-relaxed text-muted"><%= t("landing.demo.mockup_alimtalk_body") %></p>
            </div>
          <% end %>
          <p class="mt-4 text-sm font-semibold leading-relaxed text-ink"><%= t("landing.demo.step#{i}") %></p>
        <% end %>
      <% end %>
    </div>

    <p class="mt-6 rounded-xl border border-line bg-canvas px-4 py-3 text-sm text-muted" role="note">
      <%= t("landing.demo.note") %>
    </p>
  </div>
</section>

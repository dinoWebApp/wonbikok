<%# 1. 히어로 — 3초 안에 '나 이야기인가' 확인 (PRD 13.2) · 헤드라인 A형 기본 (13.3)
    '반나절→15분'은 검증 전 수치이므로 '설계 목표' 각주 병기 (13.4) %>
<section class="border-b border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-2 md:items-center md:gap-12 md:py-20">
    <div>
      <h1 class="text-3xl font-extrabold leading-snug tracking-tight text-ink md:text-4xl md:leading-snug">
        <%= t("landing.hero.headline") %>
      </h1>
      <p class="mt-2 text-xs text-muted"><%= t("landing.hero.headline_note") %></p>
      <p class="mt-5 text-base leading-relaxed text-muted md:text-lg"><%= t("landing.hero.subcopy") %></p>
      <div class="mt-7">
        <%= link_to t("landing.hero.cta"), "#beta",
              class: "btn-primary btn-lg w-full md:w-auto md:px-6",
              data: { event: "cta_hero" } %>
      </div>
    </div>

    <%# 제품 화면 대체 — 모바일 프레임 CSS 목업 (실 스크린샷 확보 후 교체, 13.7 대체 텍스트 제공) %>
    <div class="justify-self-center">
      <div class="w-64 max-w-full rounded-[2rem] border-4 border-ink/80 bg-surface p-3"
           role="img" aria-label="<%= t("landing.hero.mockup.aria") %>">
        <div class="rounded-xl bg-canvas p-3">
          <p class="text-xs font-semibold text-muted"><%= t("landing.hero.mockup.month") %></p>
          <div class="mt-2 flex gap-1.5">
            <span class="rounded-md border border-warning-200 bg-warning-50 px-2 py-1 text-xs font-semibold text-warning-700"><%= t("landing.hero.mockup.unpaid_badge") %></span>
            <span class="rounded-md border border-success-200 bg-success-50 px-2 py-1 text-xs font-semibold text-success-700"><%= t("landing.hero.mockup.paid_badge") %></span>
          </div>
        </div>
        <ul class="mt-3 space-y-2">
          <% t("landing.hero.mockup.rows").each do |row| %>
            <li class="flex items-center justify-between gap-2 rounded-lg border border-line px-3 py-2">
              <span class="text-sm font-semibold text-ink"><%= row[:name] %></span>
              <span class="text-sm tabular-nums text-ink"><%= row[:amount] %></span>
              <% if row[:state] == t("landing.hero.mockup.state_paid") %>
                <span class="inline-flex items-center gap-1 rounded-full border border-success-200 bg-success-50 px-2 py-0.5 text-xs font-semibold text-success-700">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
                  <%= row[:state] %>
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-full border border-warning-200 bg-warning-50 px-2 py-0.5 text-xs font-semibold text-warning-700"><%= row[:state] %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>

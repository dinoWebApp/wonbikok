<%# 플랜 카드 — PRD 11.1 항목 표기. 미지원 항목은 명확히 "미지원" 표기 (13.4)
    locals: plan(카드 해시), cycle_price(월간/연간 가격 문자열), cycle_note(결제 주기 안내) %>
<div class="flex flex-col rounded-xl border border-line bg-surface p-5 md:p-6">
  <p class="text-sm font-bold text-muted"><%= plan[:name] %></p>
  <p class="mt-2 text-3xl font-extrabold tabular-nums tracking-tight text-ink"><%= cycle_price %></p>
  <p class="mt-1 text-xs text-muted"><%= cycle_note %></p>
  <dl class="mt-5 space-y-0 border-t border-line">
    <% plan[:rows].each_with_index do |(label, value), index| %>
      <div class="<%= index.zero? ? "" : "border-t border-line " %>flex items-start justify-between gap-3 py-2.5">
        <dt class="text-sm text-muted"><%= label %></dt>
        <% supported = value == t("landing.pricing.plan_supported") %>
        <% if supported || value == t("landing.pricing.plan_not_supported") %>
          <%# 지원/미지원은 색상+텍스트 병행 (PRD 16.0 — 색만으로 전달 금지) %>
          <dd class="shrink-0 text-sm font-semibold <%= supported ? "text-success-700" : "text-muted" %>">
            <% unless supported %>
              <svg class="mr-1 inline h-3.5 w-3.5 -translate-y-px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg>
            <% end %><%= value %>
          </dd>
        <% else %>
          <dd class="text-right text-sm font-semibold text-ink"><%= value %></dd>
        <% end %>
      </div>
    <% end %>
  </dl>
</div>

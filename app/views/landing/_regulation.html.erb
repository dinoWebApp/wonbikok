<%# 5. 규제 안내 — '해야 하는 일'임을 객관화 (PRD 13.2·13.3 카피 그대로)
    톤 주의: 겁주기 금지 — 사실 나열 후 '안심'으로 마무리 (13.4) %>
<section class="border-b border-line bg-surface">
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-20">
    <%= render layout: "shared/card", locals: { class: "p-6 md:p-8" } do %>
      <h2 class="text-xl font-extrabold tracking-tight text-ink md:text-2xl"><%= t("landing.regulation.title") %></h2>
      <p class="mt-4 text-base leading-relaxed text-muted"><%= t("landing.regulation.body") %></p>
      <p class="mt-4 border-t border-line pt-4 text-base font-bold leading-relaxed text-ink"><%= t("landing.regulation.close") %></p>
      <p class="mt-5">
        <%= link_to t("landing.regulation.link"), "https://www.nts.go.kr",
              target: "_blank", rel: "noopener",
              class: "inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-brand-700 underline underline-offset-2" %>
      </p>
    <% end %>
  </div>
</section>

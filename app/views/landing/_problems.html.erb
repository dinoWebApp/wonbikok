<%# 2. 문제 공감 — 원장의 월간 풍경 재현, 3 페인 카드 (PRD 13.2·13.3 문구 그대로) %>
<section class="border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-ink md:text-3xl"><%= t("landing.problems.title") %></h2>
    <p class="mt-3 text-base leading-relaxed text-muted"><%= t("landing.problems.subtitle") %></p>
    <div class="mt-8 grid gap-4 md:grid-cols-3 md:gap-5">
      <% 1.upto(3) do |i| %>
        <%= render layout: "shared/card", locals: { class: "p-5" } do %>
          <svg class="h-6 w-6 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <% if i == 1 %>
              <%# 통장 대조 %>
              <rect x="3.5" y="5.5" width="17" height="13" rx="2"/>
              <path d="M3.5 9.5h17M7 14.5h4"/>
            <% elsif i == 2 %>
              <%# 독촉 전화 %>
              <path d="M5.5 4.5h3l1.5 4-2 1.5a12.5 12.5 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 6.7a2 2 0 0 1 2-2.2z"/>
            <% else %>
              <%# 홈택스 + 공동인증서 %>
              <rect x="4" y="4" width="16" height="16" rx="2"/>
              <path d="M8 9h8M8 13h5"/>
              <circle cx="8.2" cy="16.8" r="0.9" fill="currentColor" stroke="none"/>
            <% end %>
          </svg>
          <p class="mt-3 text-base font-semibold leading-relaxed text-ink"><%= t("landing.problems.card#{i}_title") %></p>
          <p class="mt-2 text-sm font-medium text-muted"><%= t("landing.problems.card#{i}_sub") %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

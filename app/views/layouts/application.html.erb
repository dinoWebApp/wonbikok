<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wonbikok">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Pretendard 웹폰트 (CDN 실패 시 시스템 폰트 폴백 — tailwind.config.js font-sans 스택) %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css" crossorigin>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-canvas font-sans text-base leading-relaxed text-ink antialiased">
    <% if authenticated? %>
      <%# 앱 셸 — 상단 헤더(모바일) + 데스크톱 내비게이션 + 모바일 하단 탭 (PRD 16.0·15.4) %>
      <header class="sticky top-0 z-40 border-b border-line bg-surface">
        <div class="mx-auto max-w-2xl px-4">
          <div class="flex h-14 items-center justify-between gap-2">
            <div class="flex min-w-0 items-center gap-2">
              <%= link_to dashboard_path, class: "-ml-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2", "aria-label": t("app_name") do %>
                <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 21.5s-7.5-5.6-7.5-11a7.5 7.5 0 1 1 15 0c0 5.4-7.5 11-7.5 11z" fill="#EA580C" opacity="0.16"/>
                  <path d="M12 21.5s-7.5-5.6-7.5-11a7.5 7.5 0 1 1 15 0c0 5.4-7.5 11-7.5 11z" fill="#EA580C"/>
                  <circle cx="12" cy="10.5" r="2.6" fill="#FFFFFF"/>
                </svg>
                <span class="text-lg font-extrabold tracking-tight text-ink"><%= t("app_name") %></span>
              <% end %>
              <% if practice_mode? %>
                <span class="whitespace-nowrap rounded-full border border-warning-200 bg-warning-50 px-2.5 py-0.5 text-xs font-semibold text-warning-700"><%= t("practice.badge") %></span>
              <% end %>
            </div>

            <%# 데스크톱(md 이상): 상단 헤더 내비게이션 %>
            <nav class="hidden items-center gap-1 md:flex" aria-label="<%= t("nav.aria_label") %>">
              <%
                desktop_tabs = [
                  { label: t("nav.home"), url: dashboard_path, active: request.path == "/dashboard" },
                  { label: t("nav.students"), url: students_path, active: request.path.start_with?("/students") },
                  { label: t("nav.invoices"), url: invoices_path, active: request.path.start_with?("/invoices") },
                  { label: t("nav.reminders"), url: reminders_path, active: request.path.start_with?("/reminders") }
                ]
              %>
              <% desktop_tabs.each do |tab| %>
                <%= link_to tab[:label], tab[:url],
                      class: "inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold #{tab[:active] ? 'bg-brand-50 text-brand-700' : 'text-muted hover:bg-canvas hover:text-ink'}",
                      **(tab[:active] ? { "aria-current": "page" } : {}) %>
              <% end %>
              <span class="mx-2 hidden max-w-[10rem] truncate text-sm text-muted lg:inline" title="<%= current_tenant.name %>"><%= current_tenant.name %></span>
              <%= button_to t("auth.sign_out"), session_path, method: :delete,
                    class: "inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink" %>
            </nav>

            <%# 모바일: 로그아웃만 (내비게이션은 하단 탭) %>
            <div class="md:hidden">
              <%= button_to t("auth.sign_out"), session_path, method: :delete,
                    form: { class: "inline" },
                    class: "inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-semibold text-muted hover:text-ink" %>
            </div>
          </div>
        </div>
      </header>
      <% if practice_mode? %>
        <div class="border-b border-warning-200 bg-warning-50 text-sm text-warning-700" role="status">
          <p class="mx-auto max-w-2xl px-4 py-2"><%= t("practice.notice") %></p>
        </div>
      <% end %>
    <% end %>

    <main class="mx-auto w-full max-w-2xl px-4 pb-24 pt-5 md:pb-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <% if authenticated? %>
      <%# 모바일 하단 탭 내비게이션 — 홈/원생/청구/알림 (레퍼런스: 미니스탁·캐시노트) %>
      <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface md:hidden"
           aria-label="<%= t("nav.aria_label") %>"
           style="padding-bottom: env(safe-area-inset-bottom)">
        <div class="mx-auto flex max-w-2xl">
          <%
            mobile_tabs = [
              { label: t("nav.home"), url: dashboard_path, active: request.path == "/dashboard", icon: "home" },
              { label: t("nav.students"), url: students_path, active: request.path.start_with?("/students"), icon: "students" },
              { label: t("nav.invoices"), url: invoices_path, active: request.path.start_with?("/invoices"), icon: "invoices" },
              { label: t("nav.reminders"), url: reminders_path, active: request.path.start_with?("/reminders"), icon: "reminders" }
            ]
          %>
          <% mobile_tabs.each do |tab| %>
            <%= link_to tab[:url],
                  class: "flex min-h-14 flex-1 flex-col items-center justify-center gap-0.5 py-1.5 #{tab[:active] ? 'text-brand-600' : 'text-muted'}",
                  **(tab[:active] ? { "aria-current": "page" } : {}) do %>
              <% if tab[:icon] == "home" %>
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.8 10.6 12 3.9l8.2 6.7"/>
                  <path d="M6.1 9.3v10.8h11.8V9.3"/>
                </svg>
              <% elsif tab[:icon] == "students" %>
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="9" cy="8.3" r="3.3"/>
                  <path d="M3.4 19.6c.7-3.1 3-4.8 5.6-4.8s4.9 1.7 5.6 4.8"/>
                  <circle cx="17" cy="9.4" r="2.7"/>
                  <path d="M16.6 14.6c2 .2 3.6 1.6 4.2 3.8"/>
                </svg>
              <% elsif tab[:icon] == "invoices" %>
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-3.25-2.2-3.25 2.2-3.25-2.2L5 20.5v-16a1 1 0 0 1 1-1z"/>
                  <path d="M9.2 8.5h5.6M9.2 12h5.6"/>
                </svg>
              <% else %>
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18.2 10.2a6.2 6.2 0 1 0-12.4 0c0 4.6-1.6 5.8-1.6 5.8h15.6s-1.6-1.2-1.6-5.8z"/>
                  <path d="M10 19.4a2.1 2.1 0 0 0 4 0"/>
                </svg>
              <% end %>
              <span class="text-xs font-semibold leading-none"><%= tab[:label] %></span>
            <% end %>
          <% end %>
        </div>
      </nav>
    <% end %>
  </body>
</html>

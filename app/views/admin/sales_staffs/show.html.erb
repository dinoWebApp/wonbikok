<% content_for :title, @sales_staff.name %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-xl font-extrabold tracking-tight"><%= @sales_staff.name %></h1>
    <p class="mt-1 text-sm text-muted">
      <%= t("admin.sales_staffs.roles.#{@sales_staff.role}") %>
      <% if @sales_staff.title.present? %> · <%= @sales_staff.title %><% end %>
      · <%= @sales_staff.email %><%# 업무 연락처 — 마스킹 불필요(ADM-002 대상 외) %>
    </p>
  </div>
  <%= render "shared/button", label: t("admin.sales_staffs.show.back_to_index"),
        url: admin_sales_staffs_path, variant: :secondary %>
</div>

<%# 계정 상태 %>
<section class="mt-4 rounded-xl border border-line bg-surface p-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-bold">
        <% if @sales_staff.active? %>
          <span class="rounded-full bg-success-50 px-2 py-0.5 text-xs font-semibold text-success-700"><%= t("admin.sales_staffs.statuses.active") %></span>
        <% else %>
          <span class="rounded-full bg-danger-50 px-2 py-0.5 text-xs font-semibold text-danger-700"><%= t("admin.sales_staffs.statuses.suspended") %></span>
        <% end %>
        <span class="ml-2 text-xs text-muted">
          <%= t("admin.sales_staffs.show.rate_cap",
                rate: (@sales_staff.effective_commission_rate * 100).round(1),
                cap: @sales_staff.effective_cap_months.present? ? t("admin.sales_staffs.cap_months", months: @sales_staff.effective_cap_months) : t("admin.sales_staffs.cap_unlimited")) %>
        </span>
      </p>
      <% if @sales_staff.suspended? %>
        <p class="mt-2 text-xs text-danger-700"><%= t("admin.sales_staffs.show.suspended_reason", reason: @sales_staff.suspended_reason) %></p>
      <% end %>
    </div>
    <%# REF-007: 정지(사유 필수) — 유효 코드 즉시 무효화·로그인 차단 / 해제도 사유 필수(ADM-001) %>
    <% if @sales_staff.active? %>
      <%= form_with url: suspend_admin_sales_staff_path(@sales_staff), method: :post,
            class: "flex items-center gap-2" do %>
        <%= text_field_tag :reason, nil, required: true,
              placeholder: t("admin.actions.reason_placeholder"),
              class: "w-64 rounded-lg border border-line bg-surface px-3 py-2 text-sm" %>
        <%= render "shared/button", label: t("admin.sales_staffs.show.suspend"),
              variant: :destructive_secondary, type: "submit" %>
      <% end %>
    <% else %>
      <%= form_with url: resume_admin_sales_staff_path(@sales_staff), method: :post,
            class: "flex items-center gap-2" do %>
        <%= text_field_tag :reason, nil, required: true,
              placeholder: t("admin.actions.reason_placeholder"),
              class: "w-64 rounded-lg border border-line bg-surface px-3 py-2 text-sm" %>
        <%= render "shared/button", label: t("admin.sales_staffs.show.resume"),
              variant: :secondary, type: "submit" %>
      <% end %>
    <% end %>
  </div>
</section>

<%# 수수료 요약 — 최근 %{months}개월 월별 + 당해 연도 누적(지급/미지급 구분) %>
<section class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-sm font-bold text-muted"><%= t("admin.sales_staffs.show.monthly_summary_title") %></h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-3 py-2"><%= t("sales.dashboard.col_month") %></th>
            <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_base") %></th>
            <th class="px-3 py-2 text-right"><%= t("sales.dashboard.col_commission") %></th>
            <th class="px-3 py-2 text-right"><%= t("admin.sales_staffs.show.col_count") %></th>
          </tr>
        </thead>
        <tbody>
          <% @monthly_rows.each do |row| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-3 py-2"><%= row.month %></td>
              <td class="px-3 py-2 text-right font-mono"><%= number_to_currency(row.base_amount, unit: "₩", precision: 0) %></td>
              <td class="px-3 py-2 text-right font-mono font-bold"><%= number_to_currency(row.amount, unit: "₩", precision: 0) %></td>
              <td class="px-3 py-2 text-right font-mono"><%= row.count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-sm font-bold text-muted"><%= t("admin.sales_staffs.show.yearly_title", year: @yearly.year) %></h2>
    <div class="mt-3 grid grid-cols-3 gap-3">
      <div class="rounded-lg bg-canvas p-3">
        <p class="text-xs text-muted"><%= t("sales.dashboard.yearly_total") %></p>
        <p class="mt-1 font-mono text-lg font-extrabold"><%= number_to_currency(@yearly.total_amount, unit: "₩", precision: 0) %></p>
      </div>
      <div class="rounded-lg bg-canvas p-3">
        <p class="text-xs text-muted"><%= t("sales.dashboard.yearly_paid") %></p>
        <p class="mt-1 font-mono text-lg font-extrabold text-success-700"><%= number_to_currency(@yearly.paid_amount, unit: "₩", precision: 0) %></p>
      </div>
      <div class="rounded-lg bg-canvas p-3">
        <p class="text-xs text-muted"><%= t("sales.dashboard.yearly_pending") %></p>
        <p class="mt-1 font-mono text-lg font-extrabold text-warning-700"><%= number_to_currency(@yearly.pending_amount, unit: "₩", precision: 0) %></p>
      </div>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-muted"><%= t("admin.sales_staffs.show.paid_notice") %></p>
  </div>
</section>

<%# 수수료 원장(최근 20건) — pending 건은 지급 확정(사유 필수·감사 로그 ADM-001) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.sales_staffs.show.ledgers_title") %></h2>
  <% if @recent_ledgers.empty? %>
    <div class="mt-2 rounded-xl border border-line bg-surface p-8 text-center text-sm text-muted">
      <%= t("admin.sales_staffs.show.no_ledgers") %>
    </div>
  <% else %>
    <div class="mt-2 overflow-x-auto rounded-xl border border-line bg-surface">
      <table class="w-full min-w-[52rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-4 py-2.5"><%= t("sales.dashboard.col_month") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.show.col_tenant") %></th>
            <th class="px-4 py-2.5 text-right"><%= t("sales.dashboard.col_base") %></th>
            <th class="px-4 py-2.5 text-right"><%= t("admin.sales_staffs.show.col_rate") %></th>
            <th class="px-4 py-2.5 text-right"><%= t("sales.dashboard.col_commission") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.show.col_status") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.show.col_paid_action") %></th>
          </tr>
        </thead>
        <tbody>
          <% @recent_ledgers.each do |ledger| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-4 py-2.5"><%= ledger.month %></td>
              <td class="px-4 py-2.5 font-semibold">
                <%= link_to ledger.tenant.name, admin_tenant_path(ledger.tenant), class: "text-brand-700 hover:underline" %>
              </td>
              <td class="px-4 py-2.5 text-right font-mono"><%= number_to_currency(ledger.base_amount, unit: "₩", precision: 0) %></td>
              <td class="px-4 py-2.5 text-right font-mono"><%= (ledger.rate * 100).round(1) %>%</td>
              <td class="px-4 py-2.5 text-right font-mono font-bold"><%= number_to_currency(ledger.amount, unit: "₩", precision: 0) %></td>
              <td class="px-4 py-2.5">
                <% if ledger.paid? %>
                  <span class="rounded-full bg-success-50 px-2 py-0.5 text-xs font-semibold text-success-700"><%= t("admin.sales_staffs.ledger_statuses.paid") %></span>
                  <span class="ml-1 text-xs text-muted"><%= l(ledger.paid_at, format: :short) if ledger.paid_at %></span>
                <% else %>
                  <span class="rounded-full bg-warning-50 px-2 py-0.5 text-xs font-semibold text-warning-700"><%= t("admin.sales_staffs.ledger_statuses.pending") %></span>
                <% end %>
              </td>
              <td class="px-4 py-2.5">
                <% if ledger.pending? %>
                  <%= form_with url: mark_paid_admin_sales_staff_path(@sales_staff, ledger_id: ledger.id),
                        method: :post, class: "flex items-center gap-2" do %>
                    <%= text_field_tag :reason, nil, required: true,
                          placeholder: t("admin.actions.reason_placeholder"),
                          class: "w-48 rounded-lg border border-line bg-surface px-2 py-1.5 text-xs" %>
                    <%= render "shared/button", label: t("admin.sales_staffs.show.mark_paid"),
                          variant: :secondary, type: "submit" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<%# 피판매 테넌트(상호만 — 원장 개인정보 미노출, TEN/ADM-002 준용) — 목록은 컨트롤러 주입(뷰 쿼리 금지) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.sales_staffs.show.referred_title") %></h2>
  <% if @referred_tenants.empty? %>
    <div class="mt-2 rounded-xl border border-line bg-surface p-8 text-center text-sm text-muted">
      <%= t("admin.sales_staffs.show.no_referred") %>
    </div>
  <% else %>
    <div class="mt-2 overflow-x-auto rounded-xl border border-line bg-surface">
      <table class="w-full min-w-[32rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.show.col_tenant") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.show.col_joined") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.show.col_code_snapshot") %></th>
          </tr>
        </thead>
        <tbody>
          <% @referred_tenants.each do |tenant| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-4 py-2.5 font-semibold">
                <%= link_to tenant.name, admin_tenant_path(tenant), class: "text-brand-700 hover:underline" %>
              </td>
              <td class="px-4 py-2.5 text-muted"><%= l(tenant.created_at, format: :short) %></td>
              <td class="px-4 py-2.5 font-mono text-xs"><%= tenant.referral_code_snapshot.presence || "-" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

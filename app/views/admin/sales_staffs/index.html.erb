<% content_for :title, t("admin.sales_staffs.index.title") %>

<div class="flex items-center justify-between gap-3">
  <h1 class="text-xl font-extrabold tracking-tight"><%= t("admin.sales_staffs.index.title") %></h1>
  <%= render "shared/button", label: t("admin.sales_staffs.index.new"), url: new_admin_sales_staff_path,
        variant: :primary %>
</div>
<p class="mt-1 text-xs text-muted"><%= t("admin.sales_staffs.index.role_hint") %></p>

<section class="mt-6">
  <% if @sales_staffs.empty? %>
    <div class="rounded-xl border border-line bg-surface p-8 text-center text-sm text-muted">
      <%= t("admin.sales_staffs.index.empty") %>
    </div>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-line bg-surface">
      <table class="w-full min-w-[44rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-4 py-2.5">ID</th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.col_name") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.col_email") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.col_role") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.col_title") %></th>
            <th class="px-4 py-2.5 text-right"><%= t("admin.sales_staffs.col_rate") %></th>
            <th class="px-4 py-2.5 text-right"><%= t("admin.sales_staffs.col_cap") %></th>
            <th class="px-4 py-2.5"><%= t("admin.sales_staffs.col_status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @sales_staffs.each do |staff| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-4 py-2.5 text-muted"><%= staff.id %></td>
              <td class="px-4 py-2.5 font-semibold">
                <%= link_to staff.name, admin_sales_staff_path(staff), class: "text-brand-700 hover:underline" %>
              </td>
              <td class="px-4 py-2.5 text-muted"><%= staff.email %><%# 업무 연락처 — 마스킹 불필요(ADM-002 대상 외) %></td>
              <td class="px-4 py-2.5"><span class="rounded-full bg-canvas px-2 py-0.5 text-xs font-semibold"><%= t("admin.sales_staffs.roles.#{staff.role}") %></span></td>
              <td class="px-4 py-2.5"><%= staff.title.presence || "-" %></td>
              <td class="px-4 py-2.5 text-right font-mono"><%= (staff.effective_commission_rate * 100).round(1) %>%</td>
              <td class="px-4 py-2.5 text-right font-mono"><%= staff.effective_cap_months.present? ? t("admin.sales_staffs.cap_months", months: staff.effective_cap_months) : t("admin.sales_staffs.cap_unlimited") %></td>
              <td class="px-4 py-2.5">
                <% if staff.active? %>
                  <span class="rounded-full bg-success-50 px-2 py-0.5 text-xs font-semibold text-success-700"><%= t("admin.sales_staffs.statuses.active") %></span>
                <% else %>
                  <span class="rounded-full bg-danger-50 px-2 py-0.5 text-xs font-semibold text-danger-700"><%= t("admin.sales_staffs.statuses.suspended") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<% content_for :title, t("admin.subscription_payments.refund.title") %>

<h1 class="text-xl font-extrabold tracking-tight"><%= t("admin.subscription_payments.refund.title") %></h1>
<p class="mt-1 text-sm text-muted">
  <%= t("admin.subscription_payments.refund.target", name: @tenant.name) %>
  · <%= t("admin.subscription_statuses.plan.#{@subscription.plan}") %>
  · <%= t("admin.subscription_statuses.status.#{@subscription.status}") %>
</p>
<%= link_to t("admin.subscription_payments.refund.back_to_index"), admin_subscription_payments_path,
      class: "mt-1 inline-block text-xs font-semibold text-brand-700 hover:underline" %>

<%# 정책 분기 표시(PRD 11.3 — 서비스 귀책 전액 / 이용자 귀책 규정문구 / 기간 잔여 일할) %>
<div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-3">
  <% @previews.each do |branch, plan| %>
    <div class="rounded-xl border <%= branch.to_s == @selected_branch.to_s ? "border-brand-500 bg-brand-50" : "border-line bg-surface" %> p-4">
      <p class="text-sm font-bold"><%= t("admin.refund.branches.#{branch}") %></p>
      <p class="mt-1 text-xs leading-relaxed text-muted"><%= t(plan.policy_text_key) %></p>
      <p class="mt-2 text-lg font-extrabold">
        <%= number_to_currency(plan.refund_amount, unit: "₩", precision: 0) %>
      </p>
      <% if branch == :annual_proration %>
        <p class="mt-1 text-xs text-muted">
          <%= t("admin.refund.prorated_detail",
                period_days: plan.period_days, remaining_days: plan.remaining_days) %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>

<%# 환불 확정 — 사유 필수(ADM-001)·금액은 운영자 확정값 / 실제 이체는 외부(v1.0 기록까지) %>
<%= form_with url: refund_admin_subscription_payments_path, method: :post, class: "mt-6 max-w-xl space-y-3" do |form| %>
  <%= form.hidden_field :tenant_id, value: @tenant.id %>
  <div>
    <%= form.label :branch, t("admin.subscription_payments.refund.branch"), class: "block text-sm font-semibold" %>
    <%= form.select :branch,
          Admin::RefundPolicyService::BRANCHES.map { |branch| [t("admin.refund.branches.#{branch}"), branch] },
          { selected: @selected_branch },
          required: true,
          class: "mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :amount, t("admin.subscription_payments.refund.amount"), class: "block text-sm font-semibold" %>
    <%= form.number_field :amount, min: 0, required: true, value: @base_amount,
          class: "mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2 text-sm" %>
    <p class="mt-1 text-xs text-muted"><%= t("admin.subscription_payments.refund.amount_hint") %></p>
  </div>
  <div>
    <%= form.label :reason, t("admin.subscription_payments.refund.reason"), class: "block text-sm font-semibold" %>
    <%= form.text_area :reason, rows: 2, required: true, placeholder: t("admin.actions.reason_placeholder"),
          class: "mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2 text-sm" %>
  </div>
  <p class="text-xs text-muted"><%= t("admin.subscription_payments.refund.external_notice") %></p>
  <%= form.submit t("admin.subscription_payments.refund.confirm"),
        class: "rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" %>
<% end %>

<%# 환불 이력(이 테넌트 최근 10건) %>
<section class="mt-8 max-w-xl">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.subscription_payments.refund.history_title") %></h2>
  <% if @refund_history.empty? %>
    <p class="mt-2 text-sm text-muted"><%= t("admin.subscription_payments.refund.no_history") %></p>
  <% else %>
    <ul class="mt-2 space-y-2">
      <% @refund_history.each do |event| %>
        <li class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
          <span class="text-xs text-muted"><%= l(event.created_at, format: :short) %></span>
          · <%= number_to_currency(event.amount.to_i, unit: "₩", precision: 0) %>
          <span class="block text-xs text-muted"><%= truncate(event.detail_hash["reason"].to_s, length: 60) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

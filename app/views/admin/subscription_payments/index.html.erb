<% content_for :title, t("admin.subscription_payments.index.title") %>

<h1 class="text-xl font-extrabold tracking-tight"><%= t("admin.subscription_payments.index.title") %></h1>

<%# 결제 이력 필터 — 기간(월)·유형(A3) %>
<%= form_with url: admin_subscription_payments_path, method: :get, class: "mt-4 flex flex-wrap items-center gap-2" do |form| %>
  <%= form.month_field :month, value: @query_month,
        class: "rounded-lg border border-line bg-surface px-3 py-2 text-sm" %>
  <%= form.select :event_type,
        [[t("admin.subscription_payments.filter.all"), ""]] + Admin::SubscriptionPaymentsController::EVENT_TYPES.map { |type| [t("admin.subscription_payments.event_types.#{type}"), type] },
        { selected: @query_event_type },
        class: "rounded-lg border border-line bg-surface px-3 py-2 text-sm" %>
  <%= form.submit t("admin.subscription_payments.filter.apply"),
        class: "rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700" %>
<% end %>

<%# 결제 이력 %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.subscription_payments.index.history_title") %></h2>
  <% if @event_rows.empty? %>
    <div class="mt-2 rounded-xl border border-line bg-surface p-8 text-center text-sm text-muted">
      <%= t("admin.subscription_payments.index.no_events") %>
    </div>
  <% else %>
    <div class="mt-2 overflow-x-auto rounded-xl border border-line bg-surface">
      <table class="w-full min-w-[44rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs font-semibold text-muted">
            <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_at") %></th>
            <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_tenant") %></th>
            <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_plan") %></th>
            <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_status") %></th>
            <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_type") %></th>
            <th class="px-4 py-2.5 text-right"><%= t("admin.subscription_payments.index.col_amount") %></th>
            <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_note") %></th>
          </tr>
        </thead>
        <tbody>
          <% @event_rows.each do |row| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-4 py-2.5 text-muted"><%= l(row.event.created_at, format: :short) %></td>
              <td class="px-4 py-2.5 font-semibold">
                <%= link_to row.tenant_name, admin_tenant_path(row.tenant_id), class: "text-brand-700 hover:underline" %>
              </td>
              <td class="px-4 py-2.5"><%= t("admin.subscription_statuses.plan.#{row.plan}") %></td>
              <td class="px-4 py-2.5"><%= t("admin.subscription_statuses.status.#{row.subscription_status}") %></td>
              <td class="px-4 py-2.5"><span class="rounded-full bg-canvas px-2 py-0.5 text-xs font-semibold"><%= t("admin.subscription_payments.event_types.#{row.event.event_type}") %></span></td>
              <td class="px-4 py-2.5 text-right font-mono"><%= row.event.amount.present? ? number_to_currency(row.event.amount, unit: "₩", precision: 0) : "-" %></td>
              <td class="px-4 py-2.5 text-xs text-muted"><%= truncate(row.detail_text.to_s, length: 40) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<%# 실패 모니터링 — past_due + 데이터 삭제 예정 D+30 카운트다운(산식 명시) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.subscription_payments.index.past_due_title") %></h2>
  <p class="mt-1 text-xs text-muted"><%= t("admin.subscription_payments.index.past_due_formula", days: Admin::SubscriptionPaymentsController::RETENTION_GRACE_DAYS) %></p>
  <% if @past_due_rows.empty? %>
    <div class="mt-2 rounded-xl border border-line bg-surface p-8 text-center text-sm text-muted">
      <%= t("admin.subscription_payments.index.no_past_due") %>
    </div>
  <% else %>
    <div class="mt-2 grid grid-cols-1 gap-3 md:grid-cols-2">
      <% @past_due_rows.each do |row| %>
        <div class="rounded-xl border border-warning-200 bg-warning-50 p-4">
          <div class="flex items-baseline justify-between gap-2">
            <%= link_to row.tenant_name, admin_tenant_path(row.tenant_id), class: "text-sm font-bold text-brand-700 hover:underline" %>
            <span class="text-xs font-semibold text-warning-700"><%= t("admin.subscription_statuses.plan.#{row.plan}") %></span>
          </div>
          <p class="mt-2 text-sm font-extrabold text-warning-700">
            <%= t("admin.subscription_payments.index.days_left", days: row.days_left) %>
          </p>
          <p class="mt-1 text-xs text-muted"><%= t("admin.subscription_payments.index.deadline", date: l(row.deadline, format: :default)) %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<%# 매출 집계 — 월별 manual_payment 합계(MRR 근사, 산식 명시) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.subscription_payments.index.revenue_title") %></h2>
  <p class="mt-1 text-xs text-muted"><%= t("admin.subscription_payments.index.revenue_formula") %></p>
  <div class="mt-2 overflow-x-auto rounded-xl border border-line bg-surface">
    <table class="w-full min-w-[24rem] text-sm">
      <thead>
        <tr class="border-b border-line text-left text-xs font-semibold text-muted">
          <th class="px-4 py-2.5"><%= t("admin.subscription_payments.index.col_month") %></th>
          <th class="px-4 py-2.5 text-right"><%= t("admin.subscription_payments.index.col_revenue") %></th>
        </tr>
      </thead>
      <tbody>
        <% @revenue_rows.each do |row| %>
          <tr class="border-b border-line last:border-b-0">
            <td class="px-4 py-2.5 font-semibold"><%= row.month %></td>
            <td class="px-4 py-2.5 text-right font-mono"><%= number_to_currency(row.total_amount, unit: "₩", precision: 0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

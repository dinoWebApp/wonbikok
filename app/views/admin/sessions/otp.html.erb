<% content_for :title, t("admin.sessions.otp_title") %>

<div class="w-full max-w-sm rounded-2xl border border-line bg-surface p-8 shadow-sm">
  <h1 class="text-xl font-extrabold tracking-tight"><%= t("admin.sessions.otp_title") %></h1>
  <p class="mt-1 text-sm text-muted">
    <%= t("admin.sessions.otp_description", email: @admin_user.email) %>
  </p>

  <%= form_with url: admin_session_otp_path, method: :post, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :otp_code, t("admin.sessions.otp_code"), class: "block text-sm font-semibold" %>
      <%= form.text_field :otp_code, required: true, autofocus: true,
            inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6,
            class: "mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2.5 text-center text-lg font-bold tracking-[0.5em] focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200" %>
    </div>
    <%= form.submit t("admin.sessions.sign_in"),
          class: "w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-700" %>
  <% end %>

  <p class="mt-4 text-xs text-muted">
    <%= link_to t("admin.sessions.back_to_step1"), new_admin_session_path, class: "font-semibold text-brand-700 hover:underline" %>
  </p>
</div>

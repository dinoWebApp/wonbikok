<% content_for :title, t("admin.dashboard.title") %>

<h1 class="text-xl font-extrabold tracking-tight"><%= t("admin.dashboard.title") %></h1>

<%# 외부 서비스 상태 배너 — SIMULATED(미확인) 고정. 실제 핑 금지(플레이스홀더) %>
<div class="mt-4 flex flex-wrap items-center gap-2 rounded-xl border border-line bg-surface px-4 py-3" role="status">
  <span class="text-sm font-bold"><%= t("admin.dashboard.services_label") %></span>
  <% @service_banner.each do |service| %>
    <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-canvas px-3 py-1 text-xs font-semibold text-muted">
      <%= t(service.name_key) %>
      <span class="rounded-full bg-warning-50 px-2 py-0.5 text-warning-700"><%= t(service.state_key) %></span>
    </span>
  <% end %>
</div>

<%# 오늘의 운영 상태 — 최근 24시간 실패·대기(실시간) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.dashboard.ops_status.title") %></h2>
  <div class="mt-2 grid grid-cols-2 gap-3 md:grid-cols-4">
    <div class="rounded-xl border border-danger-200 bg-danger-50 p-4">
      <p class="text-xs font-semibold text-danger-700"><%= t("admin.dashboard.ops_status.message_failed_24h") %></p>
      <p class="mt-1 text-2xl font-extrabold text-danger-700"><%= number_with_delimiter(@ops_status[:message_failed]) %></p>
    </div>
    <div class="rounded-xl border border-danger-200 bg-danger-50 p-4">
      <p class="text-xs font-semibold text-danger-700"><%= t("admin.dashboard.ops_status.receipt_failed_24h") %></p>
      <p class="mt-1 text-2xl font-extrabold text-danger-700"><%= number_with_delimiter(@ops_status[:receipt_failed]) %></p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-4">
      <p class="text-xs font-semibold text-muted"><%= t("admin.dashboard.ops_status.receipt_processing") %></p>
      <p class="mt-1 text-2xl font-extrabold"><%= number_with_delimiter(@ops_status[:receipt_processing]) %></p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-4">
      <p class="text-xs font-semibold text-muted"><%= t("admin.dashboard.ops_status.receipt_cancel_pending") %></p>
      <p class="mt-1 text-2xl font-extrabold"><%= number_with_delimiter(@ops_status[:receipt_cancel_pending]) %></p>
    </div>
  </div>
</section>

<%# 핵심 지표 카드 — 기간·산식 명시(A1 수용조건) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.dashboard.metrics.title") %></h2>
  <div class="mt-2 grid grid-cols-1 gap-3 md:grid-cols-2">
    <% @metric_rows.each do |metric| %>
      <div class="rounded-xl border border-line bg-surface p-4">
        <div class="flex items-baseline justify-between gap-2">
          <p class="text-sm font-bold"><%= t(metric.label_key) %></p>
          <% if metric.link_enabled && metric.link_url %>
            <%= link_to t("admin.dashboard.view_list"), metric.link_url, class: "text-xs font-semibold text-brand-700 hover:underline" %>
          <% end %>
        </div>
        <p class="mt-1 text-2xl font-extrabold"><%= metric.value.nil? ? "-" : number_with_delimiter(metric.value) %></p>
        <p class="mt-1 text-xs leading-relaxed text-muted"><%= t(metric.formula_key) %></p>
      </div>
    <% end %>
  </div>
</section>

<%# 추이 — 숫자 표(차트 라이브러리 없음 — 01_plan §7 후속) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.dashboard.trend.title") %></h2>
  <div class="mt-2 overflow-x-auto rounded-xl border border-line bg-surface">
    <table class="w-full min-w-[28rem] text-sm">
      <thead>
        <tr class="border-b border-line text-left text-xs font-semibold text-muted">
          <th class="px-4 py-2.5"><%= t("admin.dashboard.trend.date") %></th>
          <th class="px-4 py-2.5"><%= t("admin.dashboard.trend.messages") %></th>
          <th class="px-4 py-2.5"><%= t("admin.dashboard.trend.receipts") %></th>
        </tr>
      </thead>
      <tbody>
        <% @trend_rows.each do |row| %>
          <tr class="border-b border-line last:border-b-0">
            <td class="px-4 py-2.5 font-semibold"><%= l(row.date, format: :default) %></td>
            <td class="px-4 py-2.5"><%= number_with_delimiter(row.message_count) %></td>
            <td class="px-4 py-2.5"><%= number_with_delimiter(row.receipt_count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<%# 대응 대기 큐 — 클릭 시 A3 이동 / A5는 미구현(비활성 안내) %>
<section class="mt-6">
  <h2 class="text-sm font-bold text-muted"><%= t("admin.dashboard.queues.title") %></h2>
  <div class="mt-2 grid grid-cols-1 gap-3 md:grid-cols-2">
    <% @queues.each do |queue| %>
      <div class="rounded-xl border <%= queue.count.to_i.positive? ? "border-warning-200 bg-warning-50" : "border-line bg-surface" %> p-4">
        <div class="flex items-baseline justify-between gap-2">
          <p class="text-sm font-bold"><%= t(queue.label_key) %></p>
          <p class="text-2xl font-extrabold <%= queue.count.to_i.positive? ? "text-warning-700" : "" %>"><%= number_with_delimiter(queue.count || 0) %></p>
        </div>
        <p class="mt-1 text-xs leading-relaxed text-muted"><%= t(queue.formula_key) %></p>
        <% if queue.link_enabled && queue.link_url %>
          <%= link_to t("admin.dashboard.queues.go_a3"), queue.link_url, class: "mt-2 inline-block text-xs font-semibold text-brand-700 hover:underline" %>
        <% else %>
          <p class="mt-2 text-xs font-semibold text-muted"><%= t("admin.dashboard.queues.a5_not_ready") %></p>
        <% end %>
        <% queue.items.each do |item| %>
          <%= link_to item[:url], class: "mt-2 block rounded-lg border border-line bg-surface px-3 py-2 text-xs font-semibold hover:border-brand-300" do %>
            <%= item[:tenant_name] %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

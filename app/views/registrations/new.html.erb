<div class="mx-auto w-full max-w-sm pt-6 md:pt-14">
  <div class="mb-6">
    <h1 class="text-2xl font-extrabold tracking-tight text-ink"><%= t("registration.title") %></h1>
    <p class="mt-1 text-sm leading-relaxed text-muted"><%= t("registration.description") %></p>
  </div>

  <%= render layout: "shared/card", locals: { class: "p-5" } do %>
    <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
      <%= fields model: @tenant do |tenant_form| %>
        <%= render layout: "shared/form_field", locals: { form: tenant_form, attr: :name,
              label_text: t("registration.tenant_name"), required: true } do %>
          <%= tenant_form.text_field :name, class: "field-input" %>
        <% end %>
      <% end %>

      <%= render layout: "shared/form_field", locals: { form: form, attr: :phone_number,
            label_text: t("registration.phone_number"), required: true } do %>
        <%= form.text_field :phone_number, inputmode: "numeric", autocomplete: "tel",
              class: "field-input" %>
      <% end %>
      <%= render layout: "shared/form_field", locals: { form: form, attr: :password,
            label_text: t("registration.password"), required: true } do %>
        <%= form.password_field :password, autocomplete: "new-password",
              class: "field-input" %>
      <% end %>
      <%= render layout: "shared/form_field", locals: { form: form, attr: :password_confirmation,
            label_text: t("registration.password_confirmation"), required: true } do %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password",
              class: "field-input" %>
      <% end %>

      <%= form.submit t("registration.submit"),
            class: "btn-primary btn-lg w-full" %>
    <% end %>
  <% end %>

  <p class="mt-6 text-center text-sm text-muted">
    <%= t("registration.have_account") %>
    <%= link_to t("auth.sign_in"), new_session_path,
          class: "inline-flex min-h-11 items-center font-semibold text-brand-700 underline underline-offset-2" %>
  </p>
</div>

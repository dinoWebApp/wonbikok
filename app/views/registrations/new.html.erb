<h1 class="text-xl font-bold mb-1"><%= t("registration.title") %></h1>
<p class="text-slate-600 mb-6"><%= t("registration.description") %></p>

<%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
  <%= fields model: @tenant do |tenant_form| %>
    <div>
      <%= tenant_form.label :name, t("registration.tenant_name"), class: "block font-semibold mb-1" %>
      <%= tenant_form.text_field :name, class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
      <% @tenant.errors[:name].each do |message| %>
        <p class="mt-1 text-sm text-red-600"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :phone_number, t("registration.phone_number"), class: "block font-semibold mb-1" %>
    <%= form.text_field :phone_number, inputmode: "numeric", autocomplete: "tel",
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
    <% @user.errors[:phone_number].each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :password, t("registration.password"), class: "block font-semibold mb-1" %>
    <%= form.password_field :password, autocomplete: "new-password",
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
    <% @user.errors[:password].each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :password_confirmation, t("registration.password_confirmation"), class: "block font-semibold mb-1" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password",
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
  </div>

  <%= form.submit t("registration.submit"),
        class: "w-full min-h-12 rounded-lg bg-indigo-600 text-white font-semibold text-base hover:bg-indigo-700" %>
<% end %>

<p class="mt-6 text-slate-600">
  <%= t("registration.have_account") %>
  <%= link_to t("auth.sign_in"), new_session_path, class: "text-indigo-600 font-semibold min-h-11 inline-flex items-center" %>
</p>

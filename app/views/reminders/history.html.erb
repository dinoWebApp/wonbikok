<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold"><%= t("reminders.history.title") %></h1>
    <%= link_to t("common.back"), reminders_path,
          class: "min-h-11 px-3 inline-flex items-center rounded-lg border border-slate-300 bg-white text-sm" %>
  </div>

  <%# 원생별 필터 %>
  <%= form_with url: reminder_history_path, method: :get, class: "flex gap-2" do %>
    <%= select_tag :student_id,
          options_from_collection_for_select(@filter_students, :id, :name, params[:student_id]),
          include_blank: t("reminders.history.filter_all"),
          class: "rounded-lg border border-slate-300 px-3 py-2 text-sm",
          onchange: "this.form.requestSubmit()" %>
  <% end %>

  <% if @logs.empty? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-500">
      <%= t("reminders.history.empty") %>
    </div>
  <% else %>
    <div class="divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white">
      <% @logs.each do |log| %>
        <div class="p-4 text-sm">
          <p class="font-semibold">
            <%= log.student&.name %>
            · <%= log.invoice&.target_month %>
          </p>
          <p class="text-slate-500">
            <%= t("messages.template.#{log.template_type}") %>
            · <%= t("messages.status.#{log.status}") %>
            · <%= t("messages.channel.#{log.channel}") %>
          </p>
          <p class="text-xs text-slate-400">
            <% if log.sent_at %>
              <%= t("messages.sent_at", at: l(log.sent_at, format: :short)) %>
            <% elsif log.QUEUED? %>
              <%= t("messages.queued_note") %>
            <% elsif log.FAILED? %>
              <%= t("messages.error_line", code: log.error_code, message: log.error_message) %>
            <% end %>
            <% if log.resend_of_id.present? %>
              · <%= t("messages.resend_badge") %>
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= render layout: "shared/page_header", locals: { title: t("reminders.history.title") } do %>
  <%= render "shared/button", label: t("common.back"), url: reminders_path, variant: :secondary %>
<% end %>

<%# 원생별 필터 %>
<%= form_with url: reminder_history_path, method: :get, class: "mb-3" do %>
  <%= select_tag :student_id,
        options_from_collection_for_select(@filter_students, :id, :name, params[:student_id]),
        include_blank: t("reminders.history.filter_all"),
        "aria-label": t("reminders.history.filter_all"),
        class: "field-input",
        onchange: "this.form.requestSubmit()" %>
<% end %>

<%# 발송 이력 목록 — 상태는 색상+텍스트 배지 (PRD 16.2) %>
<div class="space-y-3">
  <% if @logs.empty? %>
    <%= render "shared/empty_state", title: t("reminders.history.empty"),
          cta_label: t("reminders.index.empty_cta"), cta_url: invoices_path %>
  <% end %>
  <% @logs.each do |log| %>
    <div class="rounded-xl border border-line bg-surface p-4 text-sm">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="min-w-0 font-bold text-ink">
          <span class="truncate"><%= log.student&.name %></span>
          · <span class="font-medium tabular-nums"><%= log.invoice&.target_month %></span>
        </p>
        <% message_tone = { "QUEUED" => :neutral, "SENDING" => :neutral, "SENT" => :success,
                            "FALLBACK_SENT" => :success, "SIMULATED" => :neutral, "FAILED" => :danger }.fetch(log.status, :neutral) %>
        <%= render "shared/badge", tone: message_tone, text: t("messages.status.#{log.status}") %>
      </div>
      <p class="mt-1.5 leading-relaxed text-muted">
        <%= t("messages.template.#{log.template_type}") %>
        · <%= t("messages.channel.#{log.channel}") %>
        <% if log.resend_of_id.present? %>
          · <%= t("messages.resend_badge") %>
        <% end %>
      </p>
      <p class="mt-1 text-xs text-muted opacity-80">
        <% if log.sent_at %>
          <span class="tabular-nums"><%= t("messages.sent_at", at: l(log.sent_at, format: :short)) %></span>
        <% elsif log.QUEUED? %>
          <%= t("messages.queued_note") %>
        <% elsif log.FAILED? %>
          <span class="font-medium text-danger-700"><%= t("messages.error_line", code: log.error_code, message: log.error_message) %></span>
        <% end %>
      </p>
    </div>
  <% end %>
</div>

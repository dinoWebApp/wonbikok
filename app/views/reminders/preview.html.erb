<%= render "shared/page_header", title: t("reminders.preview.title") %>

<% if @previews.empty? %>
  <%= render "shared/empty_state", title: t("reminders.index.empty"),
        cta_label: t("reminders.preview.back"), cta_url: reminders_path %>
<% else %>
  <%# 발송 전 최종 확인 — 미리보기 내용 + 확인 단계 (PRD 15.4) %>
  <%= form_with url: reminder_dispatch_path, method: :post, class: "space-y-3" do %>
    <% @previews.each do |preview| %>
      <div class="rounded-xl border border-line bg-surface p-4 text-sm">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="min-w-0 font-bold text-ink">
            <span class="truncate"><%= preview[:invoice].student_name_snapshot %></span>
          </p>
          <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= t("reminders.index.stage.#{preview[:stage]}") %></span>
        </div>
        <p class="mt-1.5 leading-relaxed text-muted">
          <%= t("reminders.preview.recipient") %>:
          <% if preview[:missing] %>
            <span class="font-semibold text-warning-700"><%= t("reminders.preview.no_recipient") %></span>
          <% else %>
            <span class="font-medium text-ink"><%= masked_phone(preview[:phone]) %></span>
          <% end %>
        </p>
        <% if preview[:excluded] %>
          <p class="mt-1 text-xs leading-relaxed text-warning-700"><%= t("reminders.preview.notice_excluded") %></p>
        <% end %>
        <pre class="mt-2 whitespace-pre-wrap rounded-lg bg-canvas p-3 text-xs leading-relaxed text-ink"><%= preview[:text] %></pre>
        <% unless preview[:missing] %>
          <%= hidden_field_tag "invoice_ids[]", preview[:invoice].id %>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-2 pt-2">
      <%= submit_tag t("reminders.preview.submit"),
            data: { turbo_confirm: t("reminders.preview.confirm") },
            class: "btn-primary btn-lg flex-1" %>
      <%= render "shared/button", label: t("reminders.preview.back"),
            url: reminders_path, variant: :secondary, size: :lg %>
    </div>
  <% end %>
<% end %>

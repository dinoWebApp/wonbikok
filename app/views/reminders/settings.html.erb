<%= render layout: "shared/page_header", locals: { title: t("reminders.settings.title") } do %>
  <%= render "shared/button", label: t("common.back"), url: reminders_path, variant: :secondary %>
<% end %>

<%= form_with model: @tenant, url: reminder_settings_path, method: :patch, class: "space-y-4" do |f| %>
  <%= render layout: "shared/card", locals: { class: "p-5 space-y-5" } do %>
    <%# 문구 톤 3종(부드러움/표준/공식) — 큰 터치 영역 (PRD 15.4) %>
    <fieldset>
      <legend class="text-sm font-semibold text-ink"><%= t("reminders.settings.tone") %></legend>
      <div class="mt-2 flex flex-wrap gap-2 text-sm">
        <% Tenant::REMINDER_TONES.each do |tone| %>
          <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-line bg-surface px-3.5 text-ink transition-colors has-checked:border-brand-600 has-checked:bg-brand-50 has-checked:text-brand-700">
            <%= f.radio_button :remind_tone, tone, class: "h-4 w-4 accent-brand-600" %>
            <%= t("reminders.settings.tone_options.#{tone}") %>
          </label>
        <% end %>
      </div>
      <p class="mt-1.5 text-xs leading-relaxed text-muted"><%= t("reminders.settings.tone_hint") %></p>
    </fieldset>

    <%# 단계별 ON/OFF %>
    <fieldset>
      <legend class="text-sm font-semibold text-ink"><%= t("reminders.settings.stages") %></legend>
      <div class="mt-2 space-y-1 text-sm">
        <label class="flex min-h-11 cursor-pointer items-center gap-2.5 text-ink">
          <%= f.check_box :remind_d3_enabled, class: "h-4.5 w-4.5 accent-brand-600" %>
          <%= t("reminders.settings.stage_d3") %>
        </label>
        <label class="flex min-h-11 cursor-pointer items-center gap-2.5 text-ink">
          <%= f.check_box :remind_d7_enabled, class: "h-4.5 w-4.5 accent-brand-600" %>
          <%= t("reminders.settings.stage_d7") %>
        </label>
        <label class="flex min-h-11 cursor-pointer items-center gap-2.5 text-ink">
          <%= f.check_box :remind_month_end_enabled, class: "h-4.5 w-4.5 accent-brand-600" %>
          <%= t("reminders.settings.stage_month_end") %>
        </label>
      </div>
    </fieldset>

    <%# 발송 시각 (MSG-006: 9~17시) %>
    <%= render layout: "shared/form_field", locals: { form: f, attr: :remind_send_hour,
          label_text: t("reminders.settings.send_hour"), hint: t("reminders.settings.send_hour_hint") } do %>
      <%= f.number_field :remind_send_hour, in: 9..17, class: "field-input w-24 text-right tabular-nums" %>
    <% end %>
  <% end %>

  <%# 단계별 커스텀 문구(기본 문구보다 우선) %>
  <%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
    <% { remind_custom_text_d3: :d3, remind_custom_text_d7: :d7, remind_custom_text_month_end: :month_end }.each do |attr, stage| %>
      <%= render layout: "shared/form_field", locals: { form: f, attr: attr,
            label_text: t("reminders.settings.custom_text") + " · " + t("reminders.settings.stage_#{stage}"),
            hint: t("reminders.settings.custom_hint") } do %>
        <%= f.text_area attr, rows: 3, placeholder: t("reminders.settings.custom_hint"),
              class: "w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink placeholder:opacity-60 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" %>
      <% end %>
    <% end %>
    <%= f.submit t("common.save"), class: "btn-primary btn-lg w-full" %>
  <% end %>
<% end %>

<%# 단계별 기본 문구 미리보기(예시 데이터 — 개인정보 없음) %>
<%= render layout: "shared/card", locals: { class: "mt-4 p-5 space-y-3" } do %>
  <p class="text-sm font-bold text-ink"><%= t("reminders.settings.preview_title") %></p>
  <% @previews.each do |stage, text| %>
    <div>
      <p class="text-xs font-medium text-muted"><%= t("reminders.index.stage.#{stage}") %></p>
      <pre class="mt-1 whitespace-pre-wrap rounded-lg bg-canvas p-3 text-xs leading-relaxed text-ink"><%= text %></pre>
    </div>
  <% end %>
<% end %>

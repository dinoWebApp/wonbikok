<%= render "shared/stepper", current: 1 %>

<div class="mb-5">
  <h1 class="text-xl font-bold tracking-tight text-ink"><%= t("onboarding.business.title") %></h1>
  <p class="mt-1 text-sm leading-relaxed text-muted"><%= t("onboarding.business.description") %></p>
</div>

<%= form_with model: @tenant, url: onboarding_step_path(2), method: :patch, class: "space-y-5" do |form| %>
  <%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :name,
          label_text: t("onboarding.business.name"), required: true } do %>
      <%= form.text_field :name, class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :business_number,
          label_text: t("onboarding.business.business_number"), required: true } do %>
      <%= form.text_field :business_number, inputmode: "numeric", placeholder: "1234567890",
            class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :business_type,
          label_text: t("onboarding.business.business_type"), required: true } do %>
      <%= form.select :business_type,
            Tenant.business_types.keys.map { |key| [t("enums.tenant.business_type.#{key}"), key] },
            { include_blank: true },
            { required: true, class: "field-input" } %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :owner_name,
          label_text: t("onboarding.business.owner_name"), required: true } do %>
      <%= form.text_field :owner_name, class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :address,
          label_text: t("onboarding.business.address") } do %>
      <%= form.text_field :address, class: "field-input" %>
    <% end %>
  <% end %>

  <%= form.submit t("common.next"), class: "btn-primary btn-lg w-full" %>
<% end %>

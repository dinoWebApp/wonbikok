<p class="text-sm text-indigo-600 font-semibold mb-1"><%= t("onboarding.step_label", current: 1) %></p>
<h1 class="text-xl font-bold mb-1"><%= t("onboarding.business.title") %></h1>
<p class="text-slate-600 mb-6"><%= t("onboarding.business.description") %></p>

<%= form_with model: @tenant, url: onboarding_step_path(2), method: :patch, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :name, t("onboarding.business.name"), class: "block font-semibold mb-1" %>
    <%= form.text_field :name, class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
    <% @tenant.errors[:name].each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :business_number, t("onboarding.business.business_number"), class: "block font-semibold mb-1" %>
    <%= form.text_field :business_number, inputmode: "numeric", placeholder: "1234567890", required: true,
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
    <% @tenant.errors[:business_number].each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :business_type, t("onboarding.business.business_type"), class: "block font-semibold mb-1" %>
    <%= form.select :business_type,
          Tenant.business_types.keys.map { |key| [t("enums.tenant.business_type.#{key}"), key] },
          { include_blank: true },
          { required: true, class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" } %>
    <% @tenant.errors[:business_type].each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :owner_name, t("onboarding.business.owner_name"), class: "block font-semibold mb-1" %>
    <%= form.text_field :owner_name, required: true,
          class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
    <% @tenant.errors[:owner_name].each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :address, t("onboarding.business.address"), class: "block font-semibold mb-1" %>
    <%= form.text_field :address, class: "w-full min-h-11 rounded-lg border border-slate-300 px-3 text-base" %>
  </div>

  <%= form.submit t("common.next"),
        class: "w-full min-h-12 rounded-lg bg-indigo-600 text-white font-semibold text-base hover:bg-indigo-700" %>
<% end %>

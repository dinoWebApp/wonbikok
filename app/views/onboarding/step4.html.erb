<%= render "shared/stepper", current: 3 %>

<div class="mb-5">
  <h1 class="text-xl font-bold tracking-tight text-ink"><%= t("onboarding.link.title") %></h1>
</div>

<%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
  <%# 연동 준비 상태 — 색상+텍스트 병행 (PRD 16.2) %>
  <%= render "shared/badge", tone: :neutral, text: t("onboarding.link.status_pending") %>
  <p class="text-sm leading-relaxed text-ink"><%= t("onboarding.link.description") %></p>
  <p class="text-sm leading-relaxed text-muted"><%= t("onboarding.link.disabled_notice") %></p>
<% end %>

<%= form_with url: onboarding_step_path(4), method: :patch, class: "mt-8" do %>
  <button type="submit" class="btn-primary btn-lg w-full">
    <%= t("common.next") %>
  </button>
<% end %>

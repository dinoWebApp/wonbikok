<%= render "shared/stepper", current: 2 %>

<div class="mb-5">
  <h1 class="text-xl font-bold tracking-tight text-ink"><%= t("onboarding.bank.title") %></h1>
  <p class="mt-1 text-sm leading-relaxed text-muted"><%= t("onboarding.bank.description") %></p>
</div>

<%= form_with model: @tenant, url: onboarding_step_path(3), method: :patch, class: "space-y-5" do |form| %>
  <%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :bank_name,
          label_text: t("onboarding.bank.bank_name"), required: true } do %>
      <%= form.text_field :bank_name, class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :bank_account,
          label_text: t("onboarding.bank.bank_account"), required: true } do %>
      <%= form.text_field :bank_account, inputmode: "numeric", class: "field-input" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: form, attr: :account_holder,
          label_text: t("onboarding.bank.account_holder"), required: true } do %>
      <%= form.text_field :account_holder, class: "field-input" %>
    <% end %>
  <% end %>

  <%= form.submit t("common.next"), class: "btn-primary btn-lg w-full" %>
<% end %>

<div class="space-y-4">
  <h1 class="text-xl font-bold"><%= t("invoices.cancel.title") %></h1>
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <p class="text-sm text-slate-500">
      <%= @invoice.student_name_snapshot %> · <%= @invoice.target_month %> ·
      <%= number_with_delimiter(@invoice.total_amount) %><%= t("invoices.won") %>
      (<%= t("invoices.status.#{@invoice.status}") %>)
    </p>
    <%= form_with url: cancel_invoice_path(@invoice), class: "mt-4 space-y-3" do %>
      <%= label_tag :cancel_reason, t("invoices.cancel.reason"), class: "text-sm font-semibold" %>
      <%= text_field_tag :cancel_reason, nil, required: true,
            class: "w-full rounded-lg border border-slate-300 px-3 py-2" %>
      <p class="text-xs text-slate-500"><%= t("invoices.cancel.notice") %></p>
      <%= submit_tag t("invoices.cancel.submit"),
            data: { turbo_confirm: t("invoices.cancel.confirm") },
            class: "min-h-11 w-full rounded-lg bg-red-600 text-white text-sm font-semibold" %>
    <% end %>
  </div>
</div>

<%= render "shared/page_header", title: t("invoices.edit.title", name: @invoice.student_name_snapshot, month: @invoice.target_month) %>

<% if @needs_change_reason %>
  <%# INV-002: 확정 후 수정은 변경 사유 필수 — 주의 톤 안내 (PRD 16.2) %>
  <div class="mb-4 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm leading-relaxed text-warning-700" role="status">
    <%= t("invoices.edit.change_reason_notice") %>
  </div>
<% end %>

<%= form_with model: @invoice, url: invoice_path(@invoice), method: :patch, class: "space-y-4" do |f| %>
  <% if @invoice.errors.any? %>
    <div class="rounded-xl border border-danger-200 bg-danger-50 px-4 py-3 text-sm text-danger-700" role="alert">
      <ul class="list-disc pl-4">
        <% @invoice.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= render layout: "shared/card", locals: { class: "p-5 space-y-4" } do %>
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
      <p class="text-sm text-muted"><%= t("invoices.edit.base_amount") %></p>
      <%# 금액: 오른쪽 정렬 + tabular-nums (PRD 16.1) %>
      <p class="text-base font-bold tabular-nums text-ink"><%= number_with_delimiter(@invoice.base_amount) %><%= t("invoices.won") %></p>
    </div>
    <%= render layout: "shared/form_field", locals: { form: f, attr: :adjustment_amount,
          label_text: t("invoices.edit.adjustment_amount") } do %>
      <%= f.number_field :adjustment_amount,
            class: "field-input text-right tabular-nums" %>
    <% end %>
    <%= render layout: "shared/form_field", locals: { form: f, attr: :adjustment_note,
          label_text: t("invoices.edit.adjustment_note") } do %>
      <%= f.text_field :adjustment_note, class: "field-input" %>
    <% end %>
    <% if @needs_change_reason %>
      <%# INV-002: 확정 후 수정은 변경 사유 필수 %>
      <%= render layout: "shared/form_field", locals: { form: f, attr: :change_reason,
            label_text: t("invoices.edit.change_reason"), required: true } do %>
        <%= f.text_field :change_reason, required: true, class: "field-input" %>
      <% end %>
    <% end %>
    <%= f.submit t("common.save"), class: "btn-primary btn-lg w-full" %>
  <% end %>
<% end %>

<% if @invoice.change_history_entries.any? %>
  <%= render layout: "shared/card", locals: { class: "mt-4 p-5" } do %>
    <p class="text-sm font-bold text-ink"><%= t("invoices.edit.history") %></p>
    <ul class="mt-2 space-y-2 text-sm leading-relaxed text-muted">
      <% @invoice.change_history_entries.each do |entry| %>
        <li class="border-b border-line pb-2 last:border-b-0 last:pb-0">
          <span class="tabular-nums"><%= entry["at"]&.to_datetime&.strftime("%Y-%m-%d %H:%M") %></span> · <%= entry["reason"] %> ·
          <span class="font-medium tabular-nums text-ink"><%= entry["adjustment_amount"] %><%= t("invoices.won") %></span><%= " · #{entry["adjustment_note"]}" if entry["adjustment_note"].present? %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<div class="mt-4">
  <%= render "shared/button", label: t("common.back"),
        url: invoices_path(month: @invoice.target_month), variant: :secondary, class: "w-full" %>
</div>
